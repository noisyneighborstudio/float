{
  "$schema": "/Users/sethwebster/Development/exact/scripts/app.schema.json",
  "name": "Float",
  "short_name": "Float",
  "id": "com.sethwebster.float",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0b0b0d",
  "color_scheme_dark": {
    "background_color": "#0b0b0d"
  },
  "app": {
    "id": "com.sethwebster.float",
    "name": "Float",
    "command": "float"
  },
  "modules": [
    "float-browser"
  ],
  "hatches": {
    "url-input": [
      "macos"
    ]
  },
  "data": [
    "select-seq"
  ],
  "protocol_handlers": [
    {
      "protocol": "http",
      "url": "/open?u=%s"
    },
    {
      "protocol": "https",
      "url": "/open?u=%s"
    }
  ],
  "host": {
    "web": {},
    "linux": {},
    "macos": {
      "icon": "Float.icon",
      "minimumOS": "14.0",
      "appTransportSecurity": {
        "allowsArbitraryLoadsInWebContent": true
      },
      "swiftPackages": [
        {
          "url": "https://github.com/sparkle-project/Sparkle",
          "exactVersion": "2.10.1",
          "products": [
            "Sparkle"
          ]
        }
      ],
      "infoPlist": {
        "SUFeedURL": "https://raw.githubusercontent.com/noisyneighborstudio/float/appcasts/appcast.xml",
        "SUPublicEDKey": "3mx8nIaYQAAgn78Bue6cWKssBown3v3I5Z0O1660aM0=",
        "SUEnableAutomaticChecks": true
      },
      "window": {
        "width": 640,
        "height": 360,
        "minWidth": 160,
        "minHeight": 90,
        "keepRunning": true
      }
    }
  },
  "deploy": {
    "store": {
      "web": "0",
      "linux": "0",
      "macos": "0"
    }
  }
}
