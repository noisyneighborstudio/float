{
  "$schema": "/Users/sethwebster/Development/expo/exact2/scripts/app.schema.json",
  "name": "Float",
  "short_name": "Float",
  "id": "com.sethwebster.float",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0b0b0d",
  "background_color_dark": "#0b0b0d",
  "app": {
    "id": "com.sethwebster.float",
    "name": "Float",
    "command": "float"
  },
  "modules": [
    "float-browser",
    "float-drag-strip"
  ],
  "hatches": {
    "url-input": [
      "macos"
    ]
  },
  "data": [
    "select-seq"
  ],
  "protocol_handlers": [
    {
      "protocol": "http",
      "url": "/open?u=%s"
    },
    {
      "protocol": "https",
      "url": "/open?u=%s"
    }
  ],
  "host": {
    "web": {},
    "macos": {
      "icon": "Float.icon",
      "minimumOS": "14.0",
      "appTransportSecurity": {
        "allowsArbitraryLoadsInWebContent": true
      },
      "window": {
        "width": 640,
        "height": 360,
        "minWidth": 160,
        "minHeight": 90
      }
    }
  },
  "deploy": {
    "store": {
      "web": "0",
      "macos": "0"
    }
  }
}
