test "empty home screen shows guidance and opens URL bar"
  clock data
  expect tree has "home-screen"
  expect tree has "empty-state"
  expect text "empty-shortcut" == "⌘L"
  expect tree missing "url-bar"

  tap "cmd-open-url"
  expect tree has "url-bar"
  expect tree has "url-input"

  type "url-input" key "Escape"
  expect tree missing "url-bar"
  expect state st.mode == "home"

test "URL bar resolves domains, full URLs, YouTube searches, and blocks non-http schemes"
  clock data

  // Bare domain adds https://
  tap "cmd-open-url"
  type "url-input" "netflix.com"
  type "url-input" key "Enter"
  clock data
  expect tree missing "url-bar"
  expect state st.mode == "web"
  expect state st.currentUrl == "https://netflix.com/"

  // Plain words become a YouTube search
  tap "cmd-open-url"
  type "url-input" "lofi beats"
  type "url-input" key "Enter"
  clock data
  expect state st.mode == "web"
  expect state st.currentUrl == "https://www.youtube.com/results?search_query=lofi%20beats"

  // Security hardening: non-http(s) URLs are rejected
  tap "cmd-home"
  clock data
  expect state st.mode == "home"
  tap "cmd-open-url"
  type "url-input" "file:///etc/passwd"
  type "url-input" key "Enter"
  clock data
  expect state st.mode == "home"

test "window toggles, opacity clamping, and video fill persist across reload"
  clock data
  expect state st.fill == true
  expect state st.onTop == true
  expect state st.expanded == false
  expect state st.aspectLocked == false
  expect state st.clickThrough == false
  expect state st.alpha == 1

  // Expand window toggles on and off, and docking exits expanded mode
  tap "cmd-expand"
  clock data
  expect state st.expanded == true
  tap "cmd-expand"
  clock data
  expect state st.expanded == false
  tap "cmd-expand"
  clock data
  expect state st.expanded == true
  tap "cmd-dock-0"
  clock data
  expect state st.expanded == false

  // Toggle video fill off
  tap "cmd-fill"
  clock data
  expect state st.fill == false

  // Toggle always on top off
  tap "cmd-top"
  clock data
  expect state st.onTop == false

  // Click-through caps opacity at 0.6 when above 0.6
  tap "cmd-click-through"
  clock data
  expect state st.clickThrough == true
  expect state st.alpha == 0.6

  // Fade out/in adjusts opacity
  tap "cmd-fade-out"
  clock data
  expect state st.alpha == 0.5
  tap "cmd-fade-in"
  clock data
  expect state st.alpha == 0.6

  // Aspect lock toggles
  tap "cmd-aspect"
  clock data
  expect state st.aspectLocked == true

  // Fill and alpha survive reload
  reload
  clock data
  expect state st.fill == false
  expect state st.alpha == 0.6

test "incoming protocol_handlers URL loads the page and returns route to root"
  at "/open?u=https%3A%2F%2Fvimeo.com%2F12345"
  clock +5
  clock data
  expect state st.mode == "web"
  expect state st.currentUrl == "https://vimeo.com/12345"
  tap "cmd-home"
  clock data
  expect state st.mode == "home"

test "settings route configures global quick-fade trigger and opacity and persists across reload"
  clock data
  expect state st.peekTrigger == "rightCommand"
  expect state st.peekAlpha == 0.5
  expect state st.peekHold == true

  tap "cmd-peek-25"
  clock data
  expect state st.peekAlpha == 0.25

  tap "cmd-peek-inc"
  clock data
  expect state st.peekAlpha == 0.3

  tap "cmd-peek-hotkey"
  clock data
  expect state st.peekTrigger == "hotkey"

  tap "cmd-peek-toggle"
  clock data
  expect state st.peekHold == false

  reload
  clock data
  expect state st.peekTrigger == "hotkey"
  expect state st.peekAlpha == 0.3
  expect state st.peekHold == false

test "settings route renders native Contract controls"
  at "/settings"
  clock data
  expect tree has "settings-view"
  expect tree has "hdr-mode-allow"
  expect tree has "hdr-mode-sdr"
  expect tree has "brightness-mode-single"
  expect tree has "brightness-mode-stream"
  expect tree has "settings-brightness-slider"
  expect tree missing "settings-hdr-brightness-slider"
  expect tree has "settings-contrast-slider"
  expect tree has "settings-peek-slider"
  expect tree has "reveal-style-wave"
  expect tree has "reveal-style-curtain"
  expect tree has "reveal-style-ripple"
  expect tree has "reveal-style-frost"
  expect tree has "reveal-style-louvers"
  expect tree has "reveal-style-anamorphic"
  expect tree has "open-style-lens"
  expect tree has "open-style-diagonal"
  expect tree has "open-style-portal"
  expect tree has "open-style-ripple"

  tap "brightness-mode-stream"
  clock data
  expect state st.streamBrightness == true
  expect tree has "settings-hdr-brightness-slider"

test "shortcuts route renders native Contract HUD with live global shortcuts"
  at "/shortcuts"
  clock data
  expect tree has "shortcuts-view"
  expect text "hud-show-hide-key" == "⌃⌥⌘F"
  expect text "hud-peek-key" == "Right ⌘"

test "video brightness, HDR preferences, stream-kind brightness, and View menu adjustments persist cleanly"
  clock data
  expect state st.videoBrightness == 1
  expect state st.hdrVideoBrightness == 1
  expect state st.videoContrast == 1
  expect state st.preferSdr == false
  expect state st.streamBrightness == false
  expect state st.activeVideoStream == ""

  tap "cmd-brightness-125"
  clock data
  expect state st.videoBrightness == 1.25

  tap "cmd-contrast-115"
  clock data
  expect state st.videoContrast == 1.15

  // View menu increase / decrease brightness adjusts SDR brightness when stream mode is off
  tap "cmd-brightness-up"
  clock data
  expect state st.videoBrightness == 1.35

  tap "cmd-brightness-down"
  clock data
  expect state st.videoBrightness == 1.25

  // Prefer SDR and per-stream brightness preferences
  tap "cmd-prefer-sdr-on"
  clock data
  expect state st.preferSdr == true

  tap "cmd-stream-brightness-on"
  clock data
  expect state st.streamBrightness == true

  tap "cmd-hdr-brightness-175"
  clock data
  expect state st.hdrVideoBrightness == 1.75

  // When per-stream brightness is on and active stream is HDR, View brightness commands adjust HDR brightness only
  tap "cmd-stream-hdr"
  clock data
  expect state st.activeVideoStream == "hdr"

  tap "cmd-brightness-up"
  clock data
  expect state st.hdrVideoBrightness == 1.85
  expect state st.videoBrightness == 1.25

  tap "cmd-brightness-down"
  clock data
  expect state st.hdrVideoBrightness == 1.75

  // When active stream switches to SDR, View brightness commands adjust SDR brightness only
  tap "cmd-stream-sdr"
  clock data
  expect state st.activeVideoStream == "sdr"

  tap "cmd-brightness-up"
  clock data
  expect state st.videoBrightness == 1.35
  expect state st.hdrVideoBrightness == 1.75

  // Preferences and both brightness levels persist across reload
  reload
  clock data
  expect state st.videoBrightness == 1.35
  expect state st.hdrVideoBrightness == 1.75
  expect state st.videoContrast == 1.15
  expect state st.preferSdr == true
  expect state st.streamBrightness == true

  tap "cmd-filters-reset"
  clock data
  expect state st.videoBrightness == 1
  expect state st.hdrVideoBrightness == 1
  expect state st.videoContrast == 1

test "glass reveal and open transition styles persist across reload and reverse wipe settles cleanly"
  clock data
  expect state st.revealStyle == "ripple"
  expect state st.openStyle == "ripple"

  tap "cmd-reveal-curtain"
  clock data
  expect state st.revealStyle == "curtain"

  tap "cmd-open-diagonal"
  clock data
  expect state st.openStyle == "diagonal"

  reload
  clock data
  expect state st.revealStyle == "curtain"
  expect state st.openStyle == "diagonal"

  // Navigate to a site and return Home: reverse glass wipe mounts then unmounts cleanly
  tap "cmd-open-url"
  type "url-input" "vimeo.com"
  type "url-input" key "Enter"
  clock data
  expect state st.mode == "web"

  tap "cmd-home"
  clock data
  expect state st.mode == "home"
  expect state fxKind == 5
  expect tree has "home-transition-fx"

  clock +1100
  expect state fxKind == 0
  expect tree missing "home-transition-fx"

test "trailing + card opens streaming providers page, adds cards to mosaic, and opens card to sign in"
  clock data
  expect tree has "site-grid"
  expect tree has "add-provider-card"

  // Clicking the + card opens the streaming providers page
  tap "add-provider-card"
  clock data
  expect tree has "providers-view"
  expect tree has "providers-grid"
  expect tree has "provider-netflix"
  expect tree has "provider-appletv"
  expect tree has "provider-youtube"
  expect tree missing "provider-added-netflix"

  // Clicking a provider logo adds a card and marks it added
  tap "provider-netflix"
  clock data
  expect tree has "provider-added-netflix"
  expect state st.sites.length == 1

  // Filtering by category narrows the directory
  tap "provider-cat-anime"
  clock data
  expect tree has "provider-crunchyroll"
  expect tree missing "provider-netflix"

  tap "provider-cat-all"
  clock data

  // Search matches aliases as well as provider names
  type "providers-search" "apple"
  clock data
  expect tree has "provider-appletv"
  expect tree missing "provider-netflix"

  // Add Apple TV+ while filtered
  tap "provider-appletv"
  clock data
  expect tree has "provider-added-appletv"
  expect state st.sites.length == 2

  // Toggle off and back on verifies add/remove
  tap "provider-appletv"
  clock data
  expect tree missing "provider-added-appletv"
  expect state st.sites.length == 1
  tap "provider-appletv"
  clock data
  expect tree has "provider-added-appletv"
  expect state st.sites.length == 2

  // Return to Home: both provider cards and the trailing + card appear in the mosaic
  tap "providers-done"
  clock data
  expect tree missing "providers-view"
  expect tree has "home-screen"
  expect tree has "tile-www.netflix.com"
  expect tree has "tile-tv.apple.com"
  expect tree has "add-provider-card"
  expect text "tile-name-www.netflix.com" == "Netflix"
  expect text "tile-name-tv.apple.com" == "Apple TV+"

  // Added provider cards persist across reload
  reload
  clock data
  expect tree has "tile-www.netflix.com"
  expect tree has "tile-tv.apple.com"
  expect tree has "add-provider-card"

  // Clicking a card opens that provider so the user can sign in
  tap "tile-tv.apple.com"
  clock +250
  clock data
  expect state st.mode == "web"
  expect state st.currentUrl == "https://tv.apple.com/"

test "providers search empty state can open URL bar with the typed query"
  clock data
  tap "add-provider-card"
  clock data
  expect tree has "providers-view"

  type "providers-search" "example.org"
  clock data
  expect tree has "providers-empty"
  expect tree has "providers-open-url"

  tap "providers-open-url"
  clock data
  expect tree missing "providers-view"
  expect tree has "url-bar"
  expect state urlDraft == "example.org"

test "switching reveal and open transition styles plays a live demo in the app window"
  clock data
  // Finish initial opening morph before testing style demos
  clock +1700
  expect state fxKind == 0
  expect tree missing "home-transition-fx"

  // Switching Saved Item Reveal to Glass Curtain plays curtain demo (kind 2)
  tap "cmd-reveal-curtain"
  clock data
  clock +5
  expect state st.revealStyle == "curtain"
  expect state fxKind == 2
  expect state fxDemoPlaying == true
  expect tree has "home-transition-fx"
  clock +800
  expect state fxKind == 0
  expect state fxDemoPlaying == false
  expect tree missing "home-transition-fx"

  // Switching Saved Item Reveal to Wave + Bevel plays wave demo (kind 1)
  tap "cmd-reveal-wave"
  clock data
  clock +5
  expect state st.revealStyle == "wave"
  expect state fxKind == 1
  expect state fxDemoPlaying == true
  expect tree has "home-transition-fx"
  clock +1020
  expect state fxKind == 0
  expect state fxDemoPlaying == false
  expect tree missing "home-transition-fx"

  // Switching Open Site Wipe to Diagonal Wipe plays open demo (kind 4) without navigating
  tap "cmd-open-diagonal"
  clock data
  clock +5
  expect state st.openStyle == "diagonal"
  expect state st.mode == "home"
  expect state fxKind == 4
  expect state fxDemoPlaying == true
  expect tree has "home-transition-fx"
  clock +400
  expect state fxReleaseAt >= 0
  clock +400
  expect state fxKind == 0
  expect state fxDemoPlaying == false
  expect state st.mode == "home"
  expect tree missing "home-transition-fx"

  // Switching Open Site Wipe to Tile Lens plays lens demo (kind 3) without navigating
  tap "cmd-open-lens"
  clock data
  clock +5
  expect state st.openStyle == "lens"
  expect state fxKind == 3
  expect state fxDemoPlaying == true
  expect tree has "home-transition-fx"
  clock +800
  expect state fxKind == 0
  expect state fxDemoPlaying == false
  expect state st.mode == "home"
  expect tree missing "home-transition-fx"

  // Reloading does not spuriously replay the last demo
  reload
  clock data
  clock +5
  expect state st.fxDemoSeq == 0
  expect state fxKind == 0
