# Update hosting: the ONE place to change it. build.sh bakes the feed URL + public key into
# release builds; scripts/publish-appcast.sh uploads the zip to a release on FLOAT_UPDATES_REPO
# and pushes appcast.xml to its `appcasts` branch. Must be public: Sparkle never authenticates.
FLOAT_UPDATES_REPO=noisyneighborstudio/float
FLOAT_FEED_URL=https://raw.githubusercontent.com/$FLOAT_UPDATES_REPO/appcasts/appcast.xml

# Public half of the EdDSA key in login-keychain account `float` (generate_keys --account float -p).
# Private half is the SPARKLE_PRIVATE_KEY secret.
SPARKLE_PUBLIC_KEY=3mx8nIaYQAAgn78Bue6cWKssBown3v3I5Z0O1660aM0=

SPARKLE_VERSION=2.10.0
SPARKLE_SHA256=c2bf58aa8387266ac179357b1415d6f2635f044da8be41042af32425dae6da0c
