// Float: chromeless, always-on-top video browser built with Exact.
use getScreenDetails, getWindowBounds, ScreenDetails, WindowBounds from "@exact/window-management"
use globalShortcut, checkGlobalShortcut, globalShortcutStatus, globalshortcut, globalshortcutup, GlobalShortcut, GlobalShortcutCheck, GlobalShortcutStatus from "@exact/global-shortcuts"
use ShaderState from "@exact/shader"

routes nav
  home "/"
    providers "/providers"
    settings "/settings"
    shortcuts "/shortcuts"
  open "/open"

shape Page
  name: string
  platform: string
  visibilityState: string
  persisted: bool
  restores: number

shape Viewport
  width: number
  height: number
  prefersReducedMotion: bool

shape Site
  host: string
  url: string
  icon: string
  name: string
  initial: string
  last: number
  count: number

shape FloatState
  mode: string
  currentUrl: string
  fill: bool
  onTop: bool
  expanded: bool
  aspectLocked: bool
  clickThrough: bool
  alpha: number
  videoBrightness: number
  hdrVideoBrightness: number
  videoContrast: number
  revealStyle: string
  openStyle: string
  fxDemoSeq: number
  fxDemoKind: number
  preloadedHost: string
  webContentReady: bool
  preferSdr: bool
  streamBrightness: bool
  activeVideoStream: string
  hotkeyKeys: string
  hotkeyLabel: string
  peekTrigger: string
  peekAlpha: number
  peekHotkeyKeys: string
  peekHotkeyLabel: string
  peekHold: bool
  canCheckUpdates: bool
  nativeBackdrop: bool
  browserFrame: string
  hasResume: bool
  resumeUrl: string
  resumeTitle: string
  resumeHost: string
  resumeIcon: string
  resumeTime: number
  resumeDuration: number
  sites: Site[]

shape Reply
  ok: bool

shape AspectReply
  ok: bool
  ratio: number

shape StreamingProvider
  id: string
  name: string
  host: string
  normHost: string
  url: string
  icon: string
  category: string

shape ProviderCatalog
  items: StreamingProvider[]
  total: number

fn normHost(h: string): string = h.toLowerCase().startsWith("www.") ? h.toLowerCase().slice(4) : h.toLowerCase()

fn pad2(n: number): string = n < 10 ? `0${n}` : `${n}`

fn fmtTime(sec: number): string = (
  floor(sec / 3600) > 0
  ? `${floor(sec / 3600)}:${pad2(floor((sec - floor(sec / 3600) * 3600) / 60))}:${pad2(floor(sec) - floor(sec / 60) * 60)}`
  : `${floor(sec / 60)}:${pad2(floor(sec) - floor(sec / 60) * 60)}`
)

fn tileCol(idx: number, cols: number): number = idx - floor(idx / cols) * cols
fn tileRow(idx: number, cols: number): number = floor(idx / cols)
fn tileX(idx: number, cols: number): number = tileCol(idx, cols) * 140
fn tileY(idx: number, cols: number): number = tileRow(idx, cols) * 92
fn tileWaveDelayMs(idx: number, cols: number, hasRes: bool): number = (hasRes ? 60 : 0) + min(tileCol(idx, cols) + tileRow(idx, cols), 7) * 42

style TileButton
  position="relative"
  width="100%"
  height="100%"
  border-radius=12
  background-color="-exact-tertiary-fill"
  border-width=1
  border-style="solid"
  border-color="-exact-separator"
  display="flex"
  flex-direction="column"
  align-items="center"
  justify-content="center"
  gap=8
  padding=8
  box-sizing="border-box"
  color="-exact-label"
  transition="scale 150ms ease, background-color 150ms ease"
  :hover
    background-color="-exact-fill"

style AddTileButton
  position="relative"
  width="100%"
  height="100%"
  border-radius=12
  background-color="rgba(255, 255, 255, 0.04)"
  border-width=1
  border-style="dashed"
  border-color="-exact-separator"
  display="flex"
  flex-direction="column"
  align-items="center"
  justify-content="center"
  gap=6
  padding=8
  box-sizing="border-box"
  color="-exact-secondary-label"
  transition="scale 150ms ease, background-color 150ms ease, border-color 150ms ease"
  :hover
    background-color="-exact-tertiary-fill"
    border-color="AccentColor"

style ProviderCard
  position="relative"
  width=112
  height=84
  flex-shrink=0
  border-radius=12
  background-color="-exact-tertiary-fill"
  border-width=1
  border-style="solid"
  border-color="-exact-separator"
  display="flex"
  flex-direction="column"
  align-items="center"
  justify-content="center"
  gap=6
  padding=8
  box-sizing="border-box"
  color="-exact-label"
  transition="scale 150ms ease, background-color 150ms ease, border-color 150ms ease"

style ProviderCardAdded
  position="relative"
  width=112
  height=84
  flex-shrink=0
  border-radius=12
  background-color="rgba(20, 160, 160, 0.16)"
  border-width=1
  border-style="solid"
  border-color="AccentColor"
  display="flex"
  flex-direction="column"
  align-items="center"
  justify-content="center"
  gap=6
  padding=8
  box-sizing="border-box"
  color="-exact-label"
  transition="scale 150ms ease, background-color 150ms ease, border-color 150ms ease"

style FilterPill
  padding-top=4
  padding-bottom=4
  padding-left=10
  padding-right=10
  border-radius=14
  background-color="-exact-tertiary-fill"
  border-width=1
  border-style="solid"
  border-color="-exact-separator"
  font-size=11
  font-weight=500
  color="-exact-secondary-label"

style FilterPillActive
  padding-top=4
  padding-bottom=4
  padding-left=10
  padding-right=10
  border-radius=14
  background-color="AccentColor"
  border-width=1
  border-style="solid"
  border-color="AccentColor"
  font-size=11
  font-weight=600
  color="AccentColorText"

style HeaderBtn
  padding-top=4
  padding-bottom=4
  padding-left=10
  padding-right=10
  border-radius=8
  background-color="-exact-tertiary-fill"
  border-width=1
  border-style="solid"
  border-color="-exact-separator"
  font-size=12
  font-weight=500
  color="-exact-label"

style HeaderDoneBtn
  padding-top=4
  padding-bottom=4
  padding-left=12
  padding-right=12
  border-radius=8
  background-color="AccentColor"
  border-width=1
  border-style="solid"
  border-color="AccentColor"
  font-size=12
  font-weight=600
  color="AccentColorText"

style ResumeCard
  display="flex"
  flex-direction="row"
  align-items="center"
  gap=14
  margin-bottom=14
  padding-top=14
  padding-bottom=14
  padding-left=16
  padding-right=16
  border-radius=14
  color="-exact-label"
  background-color="-exact-secondary-fill"
  background-image="linear-gradient(135deg, rgba(20, 160, 160, 0.28), rgba(255, 255, 255, 0.05))"
  border-width=1
  border-style="solid"
  border-color="-exact-separator"
  transition="background-color 150ms ease"
  width="100%"
  box-sizing="border-box"
  :hover
    background-color="-exact-fill"

style RemoveBtn
  position="absolute"
  top=5
  right=5
  width=20
  height=20
  border-radius=10
  display="flex"
  align-items="center"
  justify-content="center"
  background-color="-exact-secondary-background"
  color="-exact-label"
  font-size=13
  :hover
    background-color="-exact-tertiary-background"

style KeyBadge
  padding-top=2
  padding-bottom=2
  padding-left=7
  padding-right=7
  border-radius=6
  background-color="-exact-secondary-fill"
  border-width=1
  border-style="solid"
  border-color="-exact-separator"

style ShortcutGroup
  flex=1
  min-width=0
  padding=12
  border-radius=12
  background-color="-exact-tertiary-fill"
  border-width=1
  border-style="solid"
  border-color="-exact-separator"
  display="flex"
  flex-direction="column"
  gap=7
  box-sizing="border-box"

style SegmentedWrap
  display="flex"
  flex-direction="row"
  width="100%"
  padding=3
  gap=3
  border-radius=9
  background-color="-exact-tertiary-fill"
  border-width=1
  border-style="solid"
  border-color="-exact-separator"
  box-sizing="border-box"

style SegmentedBtn
  flex=1
  min-width=0
  padding-top=5
  padding-bottom=5
  padding-left=8
  padding-right=8
  border-radius=6
  display="flex"
  align-items="center"
  justify-content="center"
  font-size=12
  font-weight=500
  color="-exact-secondary-label"
  background-color="transparent"

style SegmentedBtnActive
  flex=1
  min-width=0
  padding-top=5
  padding-bottom=5
  padding-left=8
  padding-right=8
  border-radius=6
  display="flex"
  align-items="center"
  justify-content="center"
  font-size=12
  font-weight=600
  color="AccentColorText"
  background-color="AccentColor"

component Float
  state urlOpen = false
  state urlDraft = ""
  state selectSeq = 0
  state hoveredHost = ""
  state dragStripHovered = false
  state prevFrame = ""
  state shownFrame = ""
  state browserDragging = false
  state savedBoundsX = 0
  state savedBoundsY = 0
  state savedBoundsW = 0
  state savedBoundsH = 0
  state hasSavedBounds = false
  state lockedAspect = 0
  state pendingBoundsOp = ""
  state pendingDockTag = 0
  state peeking = false
  state windowHidden = false
  state morphActive = true
  state morphShown = false
  state morphRevealing = false
  state fxKind = 0
  state fxSeq = 0
  state fxSlot = 0
  state fxOriginCx = 320
  state fxOriginCy = 180
  state fxOriginW = 128
  state fxOriginH = 80
  state fxOriginR = 12
  state fxStartMs = 0
  state fxReleaseAt = -1
  state fxDemoPlaying = false
  state seenDemoSeq = 0
  state pendingOpenKind = ""
  state pendingOpenUrl = ""
  state openVeilCovered = false
  state hoveredPreloadUrl = ""
  state homeItemsShown = false
  state recordingTarget = ""
  state recordingNote = ""
  state pendingHotKeyTarget = ""
  state pendingHotKeyChord = ""
  state providerCategory = "all"
  state providerQuery = ""
  state hoveredProviderId = ""
  state addTileHovered = false

  resource page = exactPage() as shape Page
  resource vp = exactViewport() as shape Viewport
  resource morphFx = exactSurface("shader") as shape ShaderState
  resource screens = getScreenDetails() as shape ScreenDetails else empty()
  resource st = loadFloatState() as shape FloatState else empty(mode="home", fill=true, onTop=true, alpha=1, videoBrightness=1, hdrVideoBrightness=1, videoContrast=1, revealStyle="ripple", openStyle="ripple", webContentReady=true, preferSdr=false, streamBrightness=false, activeVideoStream="", hotkeyKeys="Control+Alt+Meta+F", hotkeyLabel="⌃⌥⌘F", peekTrigger="rightCommand", peekAlpha=0.5, peekHotkeyKeys="Control+Alt+Meta+D", peekHotkeyLabel="⌃⌥⌘D", peekHold=true)
  resource providers = listStreamingProviders(providerCategory, providerQuery) as shape ProviderCatalog else empty()
  resource shortcutStatus = globalShortcutStatus() as shape GlobalShortcutStatus else empty()

  derive isMainWindow = page.name == "main"
  derive isSettingsWindow = page.name == "settings"
  derive isMac = page.platform == "macos"
  derive peekKeys = (
    st.peekTrigger == "rightCommand" ? "MetaRight" :
    st.peekTrigger == "rightOption" ? "AltRight" :
    st.peekTrigger == "hotkey" ? st.peekHotkeyKeys : ""
  )

  resource showHideReg = globalShortcut(id="show-hide", keys=st.hotkeyKeys) when isMainWindow and st.hotkeyKeys != "" as shape GlobalShortcut else empty()
  resource peekReg = globalShortcut(id="peek", keys=peekKeys) when isMainWindow and peekKeys != "" as shape GlobalShortcut else empty()

  mutation cmd as shape Reply queue refreshes st
  mutation bounds as shape WindowBounds then applyWindowBounds
  mutation videoAspect as shape AspectReply then applyVideoAspect
  mutation shortcutCheck as shape GlobalShortcutCheck then finishHotKeyCheck

  derive isHome = st.mode == "home"
  derive onHomeRoute = top(nav).name == "home"
  derive hasSites = st.sites.length > 0
  derive addedHosts = st.sites.map(s => normHost(s.host))
  derive isEmpty = not st.hasResume and not hasSites
  derive vpW = vp.width > 0 ? vp.width : 640
  derive vpH = vp.height > 0 ? vp.height : 360
  derive gridInnerW = max(128, vpW - 32)
  derive gridCols = max(1, floor((gridInnerW + 12) / 140))
  derive gridTotalTiles = st.sites.length + 1
  derive gridRows = floor((gridTotalTiles + gridCols - 1) / gridCols)
  derive gridHeight = gridRows * 80 + (gridRows - 1) * 12
  derive resumeProgress = st.resumeDuration > 0 ? min(100, (st.resumeTime / st.resumeDuration) * 100) : 0
  derive resumeSubtitle = (
    st.resumeDuration > 0
    ? `${fmtTime(st.resumeTime)} of ${fmtTime(st.resumeDuration)} · ${st.resumeHost}`
    : st.resumeHost
  )
  derive peekPercent = `${round(st.peekAlpha * 100)}%`
  derive brightnessPercent = `${round(st.videoBrightness * 100)}%`
  derive hdrBrightnessPercent = `${round(st.hdrVideoBrightness * 100)}%`
  derive contrastPercent = `${round(st.videoContrast * 100)}%`
  derive isPictureDefault = round(st.videoBrightness * 100) == 100 and round(st.hdrVideoBrightness * 100) == 100 and round(st.videoContrast * 100) == 100
  derive activeStreamLabel = st.activeVideoStream == "hdr" ? "HDR" : (st.activeVideoStream == "sdr" ? "SDR" : "")
  derive peekIsModifier = st.peekTrigger == "rightCommand" or st.peekTrigger == "rightOption"
  derive accessibilityTrusted = match shortcutStatus.apple { case some(a) => a.accessibilityTrusted, case none => true }
  derive needsAccessibility = isMac and peekIsModifier and not accessibilityTrusted
  derive peekHudDesc = st.peekTrigger == "none" ? "Quick Fade (Off)" : `Quick Fade (${peekPercent})`
  derive peekHudKey = (
    st.peekTrigger == "rightCommand" ? "Right ⌘" :
    st.peekTrigger == "rightOption" ? "Right ⌥" :
    st.peekTrigger == "hotkey" ? (st.peekHotkeyLabel != "" ? st.peekHotkeyLabel : "None") : "Off"
  )
  derive showHideHudKey = st.hotkeyLabel != "" ? st.hotkeyLabel : "None"
  derive hotkeyMenuTitle = `Show/Hide Hotkey: ${showHideHudKey}…`
  derive isShortcutsPanel = page.name == "shortcuts"
  derive showOpeningMorph = isMainWindow and morphActive and not vp.prefersReducedMotion and morphFx.error == ""
  derive useGlassFx = isMainWindow and not vp.prefersReducedMotion and morphFx.error == ""
  derive resumeEstH = st.resumeDuration > 0 ? 88 : 78
  derive gridTopY = st.hasResume ? (30 + resumeEstH + 14) : 30
  derive revealStyleCode = st.revealStyle == "curtain" ? 2 : 1
  derive revealStyleIsNative = st.revealStyle == "ripple" or st.revealStyle == "frost" or st.revealStyle == "louvers" or st.revealStyle == "anamorphic"
  derive openStyleIsNative = true
  derive openNativeKind = (
    st.openStyle == "diagonal" ? 4 :
    st.openStyle == "portal" ? 15 :
    st.openStyle == "ripple" ? 16 : 3
  )
  derive showHomeFx = useGlassFx and fxKind > 0
  derive tileConcealed = not homeItemsShown and not vp.prefersReducedMotion and st.revealStyle != "curtain"

  task onLaunch when isMainWindow
    after(1, checkInitialRoute)

  task onMorphShow when showOpeningMorph and morphFx.presented and not morphShown
    after(1, showMorphWindow)

  task onMorphReveal when showOpeningMorph and morphFx.presented and not morphRevealing
    after(380, revealAfterMorph)

  task onMorphEnd when showOpeningMorph and morphFx.presented
    after(700, finishOpeningMorph)

  task onMorphFallback when showOpeningMorph
    after(1600, finishOpeningMorph)

  task onFxEndWave when fxKind == 1 key=fxSeq
    after(980, finishFx)

  task onFxEndCurtain when fxKind == 2 key=fxSeq
    after(760, finishFx)

  task onFxEndOpenReleased when (fxKind == 3 or fxKind == 4) and fxReleaseAt >= 0 key=fxSeq
    after(400, finishFx)

  task onFxEndReverse when fxKind == 5 key=fxSeq
    after(1060, finishFx)

  task onFxDemo when isMainWindow and st.fxDemoSeq > seenDemoSeq and st.fxDemoKind > 0 key=st.fxDemoSeq
    after(1, playFxDemo)

  task onFxDemoRelease when fxDemoPlaying and (fxKind == 3 or fxKind == 4) and fxReleaseAt < 0 key=fxSeq
    after(360, releaseOpenVeil)

  task onOpenSwap when pendingOpenKind != "" key=fxSeq
    after(215, commitPendingOpen)

  task onWebOpenCover when (fxKind == 3 or fxKind == 4) and not fxDemoPlaying and not openVeilCovered and not st.nativeBackdrop key=fxSeq
    after(215, markVeilCovered)

  task onOpenVeilRelease when (fxKind == 3 or fxKind == 4) and not fxDemoPlaying and fxReleaseAt < 0 and openVeilCovered and not isHome and st.webContentReady key=fxSeq
    after(16, releaseOpenVeil)

  task onOpenVeilTimeout when (fxKind == 3 or fxKind == 4) and fxReleaseAt < 0 key=fxSeq
    after(8000, releaseOpenVeil)

  task onHoverPreload when isMainWindow and isHome and hoveredPreloadUrl != "" key=hoveredPreloadUrl
    after(140, triggerHoverPreload)

  task onHomeItemsReveal when isHome and not homeItemsShown and not showOpeningMorph key=fxSeq
    after(32, showHomeItems)

  task onRestore when isMainWindow and page.restores > 0 key=page.restores
    after(1, clearWindowHidden)

  task onBrowserTick when isMainWindow and not isHome and not st.nativeBackdrop
    every(120, pollBrowserFrame)

  action pollBrowserFrame
    if not isHome and st.browserFrame != ""
      if st.browserFrame != shownFrame
        let wasEmpty = shownFrame == ""
        prevFrame = shownFrame
        shownFrame = st.browserFrame
        if wasEmpty and not urlOpen
          focus("linux-browser")
      refresh st

  action browserDown(e: PointerEvent)
    if not urlOpen
      browserDragging = true
      focus("linux-browser")
      send cmd = runFloatCommand("pointerDown", `${e.offsetX / vpW},${e.offsetY / vpH}`)

  action browserMove(e: PointerEvent)
    if browserDragging and not urlOpen
      send cmd = runFloatCommand("pointerMove", `${e.offsetX / vpW},${e.offsetY / vpH}`)

  action browserUp(e: PointerEvent)
    if browserDragging
      browserDragging = false
      send cmd = runFloatCommand("pointerUp", `${e.offsetX / vpW},${e.offsetY / vpH}`)

  action browserKey(k: string, e: KeyboardEvent)
    if not urlOpen and k != "Shift" and k != "Control" and k != "Meta" and k != "Alt" and k != "AltGraph" and k != "CapsLock"
      let mods = `${e.ctrlKey ? "C" : ""}${e.metaKey ? "M" : ""}${e.altKey ? "A" : ""}${e.shiftKey ? "S" : ""}`
      send cmd = runFloatCommand("key", `${mods}:${k}`)

  action checkInitialRoute
    setWindowAlwaysOnTop(st.onTop)
    setWindowIgnoreMouseEvents(st.clickThrough)
    let topEntry = top(nav)
    if topEntry.name == "open"
      let incoming = searchParam(topEntry, "u")
      if incoming != ""
        urlOpen = false
        send cmd = runFloatCommand("load", incoming)
      nav = replace(nav, "/")

  action handleNavigate(location: string)
    let next = go(nav, location)
    let topEntry = top(next)
    if topEntry.name == "open"
      let incoming = searchParam(topEntry, "u")
      if incoming != ""
        urlOpen = false
        send cmd = runFloatCommand("load", incoming)
      nav = replace(next, "/")
    else
      nav = next

  action closeSubRoute
    if isMainWindow
      nav = back(nav)
    else
      close()

  action clearWindowHidden
    windowHidden = false

  action showMorphWindow
    morphShown = true
    send cmd = runFloatCommand("showMorphWindow", "")

  action revealAfterMorph
    morphShown = true
    morphRevealing = true
    homeItemsShown = true
    send cmd = runFloatCommand("revealGlass", "")
    if isHome and not isEmpty and useGlassFx
      fxKind = revealStyleCode
      fxReleaseAt = -1
      fxSlot = 1 - fxSlot
      fxSeq = fxSeq + 1

  action finishOpeningMorph
    if not morphRevealing
      send cmd = runFloatCommand("revealGlass", "")
    morphShown = true
    morphRevealing = true
    morphActive = false
    homeItemsShown = true

  action finishFx
    fxKind = 0
    fxReleaseAt = -1
    fxDemoPlaying = false
    openVeilCovered = false

  action playFxDemo
    let rawKind = st.fxDemoKind
    seenDemoSeq = st.fxDemoSeq
    if rawKind >= 11 and st.nativeBackdrop
      // Native macOS Metal surface transition plays directly inside FloatModule
      fxKind = 0
      fxReleaseAt = -1
      fxDemoPlaying = false
      openVeilCovered = false
      homeItemsShown = true
    else if useGlassFx and rawKind > 0
      let kind = (
        rawKind <= 4 ? rawKind :
        rawKind == 12 ? 2 :
        rawKind <= 14 ? 1 :
        rawKind <= 16 ? 3 : 4
      )
      fxDemoPlaying = true
      openVeilCovered = false
      if kind == 1
        if isHome and not showOpeningMorph
          homeItemsShown = false
        fxReleaseAt = -1
        fxKind = 1
        fxSlot = 1 - fxSlot
        fxSeq = fxSeq + 1
      else if kind == 2
        homeItemsShown = true
        fxReleaseAt = -1
        fxKind = 2
        fxSlot = 1 - fxSlot
        fxSeq = fxSeq + 1
      else if kind == 3 or kind == 4
        homeItemsShown = true
        if hasSites
          fxOriginCx = 80
          fxOriginCy = gridTopY + 40
          fxOriginW = 128
          fxOriginH = 80
          fxOriginR = 12
        else if st.hasResume
          fxOriginCx = vpW / 2
          fxOriginCy = 30 + resumeEstH / 2
          fxOriginW = max(128, vpW - 32)
          fxOriginH = resumeEstH
          fxOriginR = 14
        else
          fxOriginCx = vpW / 2
          fxOriginCy = vpH / 2
          fxOriginW = 128
          fxOriginH = 80
          fxOriginR = 12
        fxStartMs = performanceNow()
        fxReleaseAt = -1
        fxKind = kind
        fxSlot = 1 - fxSlot
        fxSeq = fxSeq + 1

  action markVeilCovered
    openVeilCovered = true

  action releaseOpenVeil
    if (fxKind == 3 or fxKind == 4) and fxReleaseAt < 0
      openVeilCovered = false
      fxReleaseAt = max(0.22, (performanceNow() - fxStartMs) / 1000)

  action showHomeItems
    homeItemsShown = true

  action triggerHoverPreload
    if isHome and hoveredPreloadUrl != ""
      send cmd = runFloatCommand("preloadSite", hoveredPreloadUrl)

  action commitPendingOpen
    let kind = pendingOpenKind
    let target = pendingOpenUrl
    pendingOpenKind = ""
    pendingOpenUrl = ""
    openVeilCovered = true
    if kind == "site" and target != ""
      send cmd = runFloatCommand("commitLoad", target)
    else if kind == "resume"
      send cmd = runFloatCommand("commitResume", "")

  action onGlobalShortcut(id: string)
    if id == "show-hide"
      if page.visibilityState == "hidden" or page.persisted or windowHidden
        windowHidden = false
        focus()
      else
        windowHidden = true
        hideWindow()
    else if id == "peek"
      if st.peekTrigger == "hotkey" and not st.peekHold
        let nextPeeking = not peeking
        peeking = nextPeeking
        setWindowOpacity(nextPeeking ? min(st.alpha, st.peekAlpha) : st.alpha, 160)
      else
        peeking = true
        setWindowOpacity(min(st.alpha, st.peekAlpha), 160)

  action onGlobalShortcutUp(id: string)
    if id == "peek" and (st.peekTrigger != "hotkey" or st.peekHold)
      peeking = false
      setWindowOpacity(st.alpha, 160)

  action showHome
    let wasWeb = not isHome
    urlOpen = false
    browserDragging = false
    pendingOpenKind = ""
    pendingOpenUrl = ""
    openVeilCovered = false
    hoveredPreloadUrl = ""
    prevFrame = ""
    shownFrame = ""
    if top(nav).name == "providers"
      providerQuery = ""
      hoveredProviderId = ""
      nav = back(nav)
    if wasWeb and useGlassFx and not (st.nativeBackdrop and revealStyleIsNative)
      fxDemoPlaying = false
      homeItemsShown = false
      fxKind = 5
      fxReleaseAt = -1
      fxSlot = 1 - fxSlot
      fxSeq = fxSeq + 1
    else
      fxDemoPlaying = false
      fxKind = 0
      homeItemsShown = true
    send cmd = runFloatCommand("showHome", "")

  action resumeLast
    urlOpen = false
    hoveredPreloadUrl = ""
    if top(nav).name == "providers"
      providerQuery = ""
      hoveredProviderId = ""
      nav = back(nav)
    send cmd = runFloatCommand("resumeLast", "")

  action openResumeCard
    urlOpen = false
    hoveredPreloadUrl = ""
    fxDemoPlaying = false
    let ox = vpW / 2
    let oy = 30 + resumeEstH / 2
    let ow = max(128, vpW - 32)
    let oh = resumeEstH
    fxOriginCx = ox
    fxOriginCy = oy
    fxOriginW = ow
    fxOriginH = oh
    fxOriginR = 14
    if useGlassFx and st.nativeBackdrop and openStyleIsNative
      send cmd = runFloatCommand("surfaceOpen", `${openNativeKind},${ox / vpW},${oy / vpH},${ow / vpW},${oh / vpH},resume,${st.resumeUrl}`)
    else if useGlassFx and st.nativeBackdrop
      fxStartMs = performanceNow()
      fxReleaseAt = -1
      fxKind = st.openStyle == "diagonal" ? 4 : 3
      openVeilCovered = false
      fxSlot = 1 - fxSlot
      fxSeq = fxSeq + 1
      pendingOpenKind = "resume"
      pendingOpenUrl = st.resumeUrl
      send cmd = runFloatCommand("prepareResume", "")
    else
      if useGlassFx
        fxStartMs = performanceNow()
        fxReleaseAt = -1
        fxKind = st.openStyle == "diagonal" ? 4 : 3
        openVeilCovered = false
        fxSlot = 1 - fxSlot
        fxSeq = fxSeq + 1
      send cmd = runFloatCommand("resumeLast", "")

  action setRevealStyle(style: string)
    send cmd = runFloatCommand("setRevealStyle", style)

  action setOpenStyle(style: string)
    send cmd = runFloatCommand("setOpenStyle", style)

  action openUrlBar
    if top(nav).name == "providers"
      providerQuery = ""
      hoveredProviderId = ""
      nav = back(nav)
    let nextDraft = st.mode == "web" ? st.currentUrl : ""
    urlDraft = nextDraft
    urlOpen = true
    selectSeq = selectSeq + 1
    focus("url-input")
    setSelectionRange("url-input", 0, nextDraft.length)

  action openProviders
    urlOpen = false
    hoveredHost = ""
    hoveredPreloadUrl = ""
    addTileHovered = false
    providerCategory = "all"
    providerQuery = ""
    hoveredProviderId = ""
    if not isHome
      send cmd = runFloatCommand("showHome", "")
    if top(nav).name != "providers"
      nav = push(nav, "/providers")

  action closeProviders
    providerQuery = ""
    hoveredProviderId = ""
    if top(nav).name == "providers"
      nav = back(nav)

  action setProviderCategory(cat: string)
    providerCategory = cat

  action editProviderQuery(v: string)
    providerQuery = v

  action hoverProvider(id: string, inside: bool)
    if inside
      hoveredProviderId = id
    else
      if hoveredProviderId == id
        hoveredProviderId = ""

  action hoverAddTile(inside: bool)
    addTileHovered = inside

  action providerKeyDown(k: string, _e: KeyboardEvent)
    if k == "Escape"
      if providerQuery != ""
        providerQuery = ""
      else
        closeProviders()

  action toggleProvider(name: string, url: string, host: string, icon: string)
    if addedHosts.includes(normHost(host))
      send cmd = runFloatCommand("removeSite", host)
    else
      send cmd = runFloatCommand("addSite", `{"url":"${url}","name":"${name}","icon":"${icon}"}`)

  action openUrlBarFromProviders
    let q = providerQuery.trim()
    providerQuery = ""
    hoveredProviderId = ""
    if top(nav).name == "providers"
      nav = back(nav)
    urlDraft = q
    urlOpen = true
    selectSeq = selectSeq + 1
    focus("url-input")
    setSelectionRange("url-input", 0, q.length)

  action setPeekTrigger(trigger: string)
    peeking = false
    recordingTarget = ""
    recordingNote = ""
    send cmd = runFloatCommand("setPeekTrigger", trigger)

  action setPeekAlpha(val: string)
    send cmd = runFloatCommand("setPeekAlpha", val)

  action onPeekAlphaRange(v: number)
    let stepped = round(min(0.95, max(0.15, v)) * 100) / 100
    send cmd = runFloatCommand("setPeekAlpha", `${stepped}`)

  action stepPeekAlpha(delta: number)
    let next = round(min(0.95, max(0.15, st.peekAlpha + delta)) * 100) / 100
    send cmd = runFloatCommand("setPeekAlpha", `${next}`)

  action setPeekHold(hold: string)
    peeking = false
    send cmd = runFloatCommand("setPeekHold", hold)

  action setVideoBrightness(val: string)
    send cmd = runFloatCommand("setVideoBrightness", val)

  action onBrightnessRange(v: number)
    let stepped = round(min(2, max(0.5, v)) * 100) / 100
    send cmd = runFloatCommand("setVideoBrightness", `${stepped}`)

  action stepVideoBrightness(delta: number)
    let next = round(min(2, max(0.5, st.videoBrightness + delta)) * 100) / 100
    send cmd = runFloatCommand("setVideoBrightness", `${next}`)

  action setHdrVideoBrightness(val: string)
    send cmd = runFloatCommand("setHdrVideoBrightness", val)

  action onHdrBrightnessRange(v: number)
    let stepped = round(min(2, max(0.5, v)) * 100) / 100
    send cmd = runFloatCommand("setHdrVideoBrightness", `${stepped}`)

  action brightenVideo
    send cmd = runFloatCommand("brightenVideo", "")

  action dimVideo
    send cmd = runFloatCommand("dimVideo", "")

  action setPreferSdr(val: string)
    send cmd = runFloatCommand("setPreferSdr", val)

  action setStreamBrightness(val: string)
    send cmd = runFloatCommand("setStreamBrightness", val)

  action setActiveVideoStream(val: string)
    send cmd = runFloatCommand("setActiveVideoStream", val)

  action setVideoContrast(val: string)
    send cmd = runFloatCommand("setVideoContrast", val)

  action onContrastRange(v: number)
    let stepped = round(min(2, max(0.5, v)) * 100) / 100
    send cmd = runFloatCommand("setVideoContrast", `${stepped}`)

  action stepVideoContrast(delta: number)
    let next = round(min(2, max(0.5, st.videoContrast + delta)) * 100) / 100
    send cmd = runFloatCommand("setVideoContrast", `${next}`)

  action resetVideoFilters
    send cmd = runFloatCommand("resetVideoFilters", "")

  action requestPeekPermission
    send cmd = runFloatCommand("requestPeekPermission", "")

  action startRecording(which: string)
    recordingTarget = which
    recordingNote = ""
    focus("hotkey-capture")

  action cancelRecording
    recordingTarget = ""
    recordingNote = ""

  action captureHotKey(k: string, e: KeyboardEvent)
    if recordingTarget != ""
      if k == "Escape"
        recordingTarget = ""
        recordingNote = ""
      else if k != "Shift" and k != "Control" and k != "Meta" and k != "Alt" and k != "AltGraph" and k != "CapsLock"
        if k == "Backspace" and not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey
          let op = recordingTarget == "show-hide" ? "setHotkeyKeys" : "setPeekHotkeyKeys"
          recordingTarget = ""
          recordingNote = ""
          send cmd = runFloatCommand(op, "")
        else if not e.metaKey and not e.ctrlKey and not e.altKey
          recordingNote = "Include ⌘, ⌃, or ⌥ in the shortcut."
        else
          let keyName = k == " " ? "Space" : (k.length == 1 ? k.toUpperCase() : k)
          let chord = `${e.ctrlKey ? "Control+" : ""}${e.altKey ? "Alt+" : ""}${e.shiftKey ? "Shift+" : ""}${e.metaKey ? "Meta+" : ""}${keyName}`
          pendingHotKeyTarget = recordingTarget
          pendingHotKeyChord = chord
          if isMac
            send shortcutCheck = checkGlobalShortcut(keys=chord)
          else
            let op = recordingTarget == "show-hide" ? "setHotkeyKeys" : "setPeekHotkeyKeys"
            recordingTarget = ""
            recordingNote = ""
            send cmd = runFloatCommand(op, chord)

  action finishHotKeyCheck
    let target = pendingHotKeyTarget
    let chord = pendingHotKeyChord
    pendingHotKeyTarget = ""
    pendingHotKeyChord = ""
    if target != "" and chord != ""
      match shortcutCheck
        case some(res)
          if res.registered
            let op = target == "show-hide" ? "setHotkeyKeys" : "setPeekHotkeyKeys"
            recordingTarget = ""
            recordingNote = ""
            send cmd = runFloatCommand(op, chord)
          else
            recordingNote = "That shortcut is unavailable or already in use."
        case none
          let op = target == "show-hide" ? "setHotkeyKeys" : "setPeekHotkeyKeys"
          recordingTarget = ""
          recordingNote = ""
          send cmd = runFloatCommand(op, chord)

  action editUrl(v: string)
    urlDraft = v

  action submitUrl
    let target = urlDraft.trim()
    urlOpen = false
    if target != ""
      send cmd = runFloatCommand("load", target)
    else
      send cmd = runFloatCommand("focusWeb", "")
    if st.browserFrame != ""
      focus("linux-browser")

  action cancelUrl
    urlOpen = false
    send cmd = runFloatCommand("focusWeb", "")
    if not isHome and st.browserFrame != ""
      focus("linux-browser")

  action urlKeyDown(k: string, e: KeyboardEvent)
    if k == "Escape"
      cancelUrl()
    else if (e.ctrlKey or e.metaKey) and (k == "a" or k == "A")
      setSelectionRange("url-input", 0, urlDraft.length)
    else if (e.metaKey and k == "Backspace") or (e.ctrlKey and (k == "u" or k == "U"))
      urlDraft = ""
      setSelectionRange("url-input", 0, 0)
    else if e.metaKey and k == "ArrowLeft"
      setSelectionRange("url-input", 0, 0)
    else if e.metaKey and k == "ArrowRight"
      setSelectionRange("url-input", urlDraft.length, urlDraft.length)

  action openSite(url: string, idx: number)
    urlOpen = false
    hoveredPreloadUrl = ""
    fxDemoPlaying = false
    let ox = 16 + tileX(idx, gridCols) + 64
    let oy = gridTopY + tileY(idx, gridCols) + 40
    let ow = 128
    let oh = 80
    fxOriginCx = ox
    fxOriginCy = oy
    fxOriginW = ow
    fxOriginH = oh
    fxOriginR = 12
    if useGlassFx and st.nativeBackdrop and openStyleIsNative
      send cmd = runFloatCommand("surfaceOpen", `${openNativeKind},${ox / vpW},${oy / vpH},${ow / vpW},${oh / vpH},site,${url}`)
    else if useGlassFx and st.nativeBackdrop
      fxStartMs = performanceNow()
      fxReleaseAt = -1
      fxKind = st.openStyle == "diagonal" ? 4 : 3
      openVeilCovered = false
      fxSlot = 1 - fxSlot
      fxSeq = fxSeq + 1
      pendingOpenKind = "site"
      pendingOpenUrl = url
      send cmd = runFloatCommand("prepareLoad", url)
    else
      if useGlassFx
        fxStartMs = performanceNow()
        fxReleaseAt = -1
        fxKind = st.openStyle == "diagonal" ? 4 : 3
        openVeilCovered = false
        fxSlot = 1 - fxSlot
        fxSeq = fxSeq + 1
      send cmd = runFloatCommand("load", url)

  action prewarmTile(url: string, _e: PointerEvent)
    if isHome and url != ""
      send cmd = runFloatCommand("prewarmUrl", url)

  action removeSite(host: string)
    if hoveredHost == host
      hoveredHost = ""
      hoveredPreloadUrl = ""
    send cmd = runFloatCommand("removeSite", host)

  action hoverTile(host: string, url: string, inside: bool)
    if inside
      hoveredHost = host
      hoveredPreloadUrl = url
    else
      if hoveredHost == host
        hoveredHost = ""
        hoveredPreloadUrl = ""

  action hoverDragStrip(inside: bool)
    dragStripHovered = inside

  action openClipboard
    urlOpen = false
    if top(nav).name == "providers"
      providerQuery = ""
      hoveredProviderId = ""
      nav = back(nav)
    send cmd = readClipboardUrl()

  action reloadPage
    send cmd = runFloatCommand("reloadPage", "")

  action goBack
    send cmd = runFloatCommand("back", "")

  action goForward
    send cmd = runFloatCommand("forward", "")

  action toggleFill
    send cmd = runFloatCommand("toggleFill", "")

  action applyWindowBounds
    let op = pendingBoundsOp
    pendingBoundsOp = ""
    match bounds
      case some(b)
        if b.outerWidth > 0 and b.outerHeight > 0
          let s = screens.currentScreen
          let availL = s.availLeft
          let availT = s.availTop
          let availW = s.availWidth > 0 ? s.availWidth : 1440
          let availH = s.availHeight > 0 ? s.availHeight : 900
          if op == "expand"
            savedBoundsX = b.screenX
            savedBoundsY = b.screenY
            savedBoundsW = b.outerWidth
            savedBoundsH = b.outerHeight
            hasSavedBounds = true
            let margin = 24
            let maxW = max(320, availW - margin * 2)
            let maxH = max(240, availH - margin * 2)
            let prefW = min(maxW, min(availW * 0.84, 1440))
            let prefH = min(maxH, min(availH * 0.84, 960))
            let targetW = round(b.outerWidth >= prefW - 20 ? min(maxW, availW * 0.92) : prefW)
            let targetH = round(b.outerHeight >= prefH - 20 ? min(maxH, availH * 0.92) : prefH)
            let targetX = round(availL + (availW - targetW) / 2)
            let targetY = round(availT + (availH - targetH) / 2)
            if st.aspectLocked
              setAspectRatio(0)
            setBounds(DOMRect(x=targetX, y=targetY, width=targetW, height=targetH), true)
          else if op == "dock"
            let m = 12
            let tag = pendingDockTag
            let w = min(b.outerWidth, max(160, availW - m * 2))
            let h = min(b.outerHeight, max(90, availH - m * 2))
            let col = tag - floor(tag / 3) * 3
            let x = col == 0 ? availL + m : (col == 1 ? round(availL + (availW - w) / 2) : availL + availW - w - m)
            let y = tag < 3 ? availT + m : availT + availH - h - m
            setBounds(DOMRect(x=x, y=y, width=w, height=h), true)
          else if op == "aspect"
            if lockedAspect > 0
              let h = max(90, round(b.outerWidth / lockedAspect))
              setBounds(DOMRect(x=b.screenX, y=b.screenY, width=b.outerWidth, height=h), true)
              setAspectRatio(lockedAspect)
      case none
        pendingBoundsOp = ""

  action applyVideoAspect
    match videoAspect
      case some(a)
        if a.ok and a.ratio > 0
          lockedAspect = a.ratio
          pendingBoundsOp = "aspect"
          send bounds = getWindowBounds()
          send cmd = runFloatCommand("setAspectLocked", "true")
      case none
        lockedAspect = 0

  action toggleExpand
    if st.expanded
      pendingBoundsOp = ""
      if hasSavedBounds and savedBoundsW > 0 and savedBoundsH > 0
        let s = screens.currentScreen
        let availL = s.availLeft
        let availT = s.availTop
        let availW = s.availWidth > 0 ? s.availWidth : 1440
        let availH = s.availHeight > 0 ? s.availHeight : 900
        let offscreen = (
          savedBoundsX + savedBoundsW <= availL
          or savedBoundsX >= availL + availW
          or savedBoundsY + savedBoundsH <= availT
          or savedBoundsY >= availT + availH
        )
        let rw = offscreen ? min(savedBoundsW, availW) : savedBoundsW
        let rh = offscreen ? min(savedBoundsH, availH) : savedBoundsH
        let rx = offscreen ? min(max(savedBoundsX, availL), availL + availW - rw) : savedBoundsX
        let ry = offscreen ? min(max(savedBoundsY, availT), availT + availH - rh) : savedBoundsY
        hasSavedBounds = false
        setBounds(DOMRect(x=rx, y=ry, width=rw, height=rh), true)
      else
        hasSavedBounds = false
      if st.aspectLocked and lockedAspect > 0
        setAspectRatio(lockedAspect)
      send cmd = runFloatCommand("toggleExpand", "")
    else
      pendingBoundsOp = "expand"
      send bounds = getWindowBounds()
      send cmd = runFloatCommand("toggleExpand", "")

  action toggleAspectLock
    if st.aspectLocked
      lockedAspect = 0
      setAspectRatio(0)
      send cmd = runFloatCommand("setAspectLocked", "false")
    else
      send videoAspect = queryVideoAspect()

  action toggleTop
    setWindowAlwaysOnTop(not st.onTop)
    send cmd = runFloatCommand("toggleTop", "")

  action toggleClickThrough
    let nextClickThrough = not st.clickThrough
    setWindowIgnoreMouseEvents(nextClickThrough)
    if nextClickThrough and st.alpha > 0.6
      setWindowOpacity(peeking ? min(0.6, st.peekAlpha) : 0.6, 160)
    send cmd = runFloatCommand("toggleClickThrough", "")

  action fadeOut
    let nextAlpha = round(max(0.15, st.alpha - 0.1) * 100) / 100
    setWindowOpacity(peeking ? min(nextAlpha, st.peekAlpha) : nextAlpha, 160)
    send cmd = runFloatCommand("fadeOut", "")

  action fadeIn
    let nextAlpha = round(min(1, st.alpha + 0.1) * 100) / 100
    setWindowOpacity(peeking ? min(nextAlpha, st.peekAlpha) : nextAlpha, 160)
    send cmd = runFloatCommand("fadeIn", "")

  action playPause
    send cmd = runFloatCommand("playPause", "")

  action dockPosition(tag: number)
    if st.expanded and hasSavedBounds and savedBoundsW > 0 and savedBoundsH > 0
      let s = screens.currentScreen
      let availL = s.availLeft
      let availT = s.availTop
      let availW = s.availWidth > 0 ? s.availWidth : 1440
      let availH = s.availHeight > 0 ? s.availHeight : 900
      let m = 12
      let w = min(savedBoundsW, max(160, availW - m * 2))
      let h = min(savedBoundsH, max(90, availH - m * 2))
      let col = tag - floor(tag / 3) * 3
      let x = col == 0 ? availL + m : (col == 1 ? round(availL + (availW - w) / 2) : availL + availW - w - m)
      let y = tag < 3 ? availT + m : availT + availH - h - m
      hasSavedBounds = false
      pendingBoundsOp = ""
      setBounds(DOMRect(x=x, y=y, width=w, height=h), true)
      if st.aspectLocked and lockedAspect > 0
        setAspectRatio(lockedAspect)
      send cmd = runFloatCommand("dock", `${tag}`)
    else
      pendingDockTag = tag
      pendingBoundsOp = "dock"
      send bounds = getWindowBounds()
      send cmd = runFloatCommand("dock", `${tag}`)

  action checkForUpdates
    send cmd = runFloatCommand("checkForUpdates", "")

  action onBrowserMessage(payload: string)
    if payload == "refresh"
      refresh st

  view
    main testId="float-root"
      viewport-fit=(isSettingsWindow ? "auto" : "cover")
      color-scheme="dark"
      accent-color="light-dark(#0f766e, #3fd0d0)"
      navigationKey=`${top(nav).id}`
      navigate=handleNavigate
      globalshortcut=onGlobalShortcut
      globalshortcutup=onGlobalShortcutUp
      -exact-menu-remove="close-all show-tab-bar show-all-tabs enter-full-screen minimize zoom bring-all-to-front show-previous-tab show-next-tab move-tab-to-new-window merge-all-windows paste-and-match-style find spelling-and-grammar substitutions transformations app-help actual-size zoom-in zoom-out back forward develop"
      position="relative"
      width="100%"
      height="100%"
      overflow="hidden"
      background-color=((isHome and st.nativeBackdrop and isMainWindow) or isShortcutsPanel ? "transparent" : "-exact-background")
      color="-exact-label"
      font-size=13
      user-select="none"

      for e in stack(nav) key=e.id
        if e.name == "home"
          view navigationKey=`${e.id}` navigationBar="none" position="absolute" inset=0 width="100%" height="100%"
            // Native WKWebView: always mounted to preserve back/forward history and media session
            float-browser id="browser"
              testId="browser"
              mode=st.mode
              message=onBrowserMessage
              position="absolute"
              inset=0
              width="100%"
              height="100%"
              z-index=1

            // Linux / non-native live browser bridge surface (when running with linux-browser-bridge)
            if not isHome and not st.nativeBackdrop
              if st.browserFrame != ""
                view id="linux-browser"
                  testId="linux-browser"
                  position="absolute"
                  inset=0
                  width="100%"
                  height="100%"
                  z-index=5
                  tabindex=0
                  pointerdown=browserDown
                  pointermove=browserMove
                  pointerup=browserUp
                  key=browserKey
                  opacity=st.alpha
                  background-color="-exact-background"
                  if prevFrame != ""
                    image prevFrame position="absolute"
                      inset=0
                      width="100%"
                      height="100%"
                      object-fit="fill"
                  image st.browserFrame position="absolute"
                    inset=0
                    width="100%"
                    height="100%"
                    object-fit="fill"
              else
                column testId="linux-web-placeholder"
                  position="absolute"
                  inset=0
                  z-index=5
                  align-items="center"
                  justify-content="center"
                  gap=6
                  padding=24
                  background-color="-exact-background"
                  text st.currentUrl color="-exact-label" font-size=14 text-align="center"
                  text "Press ⌘⇧H for Home · ⌘L to open another URL" color="-exact-secondary-label"
                    font-size=12
                    text-align="center"

            // Home screen: Resume card + Site mosaic grid (with trailing + card) + Empty guidance (over native macOS Liquid Glass backdrop)
            if isHome and onHomeRoute
              scroll testId="home-screen"
                position="absolute"
                inset=0
                width="100%"
                height="100%"
                z-index=10
                scrollbar-width="none"
                opacity=(showOpeningMorph and not morphRevealing ? 0 : 1)
                transition=(vp.prefersReducedMotion ? "none" : "opacity 240ms ease-out")
                background-color=(st.nativeBackdrop ? "transparent" : "-exact-background")
                background-image=(st.nativeBackdrop ? "none" : "linear-gradient(180deg, #1c1d22 0%, #0b0b0d 70%)")
                padding-top=30
                padding-left=16
                padding-right=16
                padding-bottom=16
                box-sizing="border-box"

                column width="100%"
                  if st.hasResume
                    view width="100%"
                      opacity=(tileConcealed ? 0 : 1)
                      scale=(tileConcealed ? 0.94 : 1)
                      translate=(tileConcealed ? "0px 8px" : "0px 0px")
                      filter=(tileConcealed ? "blur(6px)" : "blur(0px)")
                      transition=(tileConcealed or vp.prefersReducedMotion ? "none" : "opacity 340ms ease-out, scale 340ms cubic-bezier(0.22, 1, 0.36, 1), translate 340ms cubic-bezier(0.22, 1, 0.36, 1), filter 340ms ease-out")
                      button appearance="none"
                        class=ResumeCard
                        press=openResumeCard
                        testId="resume-card"
                        aria-label=`Resume ${st.resumeTitle}`
                        if st.resumeIcon != ""
                          image st.resumeIcon width=40
                            height=40
                            border-radius=9
                            object-fit="contain"
                            flex-shrink=0
                        column flex=1 min-width=0 gap=2 align-items="flex-start"
                          text "RESUME" font-size=11
                            letter-spacing=0.88
                            color="-exact-system-teal"
                            font-weight=500
                          text st.resumeTitle font-size=15
                            font-weight=600
                            color="-exact-label"
                            line-clamp=1
                            testId="resume-title"
                          text resumeSubtitle font-size=12
                            color="-exact-secondary-label"
                            line-clamp=1
                            testId="resume-sub"
                          if st.resumeDuration > 0
                            view width="100%"
                              height=3
                              border-radius=2
                              background-color="-exact-secondary-fill"
                              margin-top=6
                              overflow="hidden"
                              view height="100%"
                                width=`${resumeProgress}%`
                                background-color="AccentColor"
                                testId="resume-progress"
                        view width=34
                          height=34
                          border-radius=17
                          background-color="AccentColor"
                          flex-shrink=0
                          display="flex"
                          align-items="center"
                          justify-content="center"
                          padding-left=3
                          box-sizing="border-box"
                          text "▶" font-size=14 color="AccentColorText"

                  view testId="site-grid" position="relative" width="100%" height=gridHeight
                    for site, idx in st.sites key=site.host
                      view position="absolute"
                        top=0
                        left=0
                        width=128
                        height=80
                        translate=`${tileX(idx, gridCols)}px ${tileY(idx, gridCols)}px`
                        transition=(vp.prefersReducedMotion or not homeItemsShown ? "none" : "translate 220ms cubic-bezier(0.22, 1, 0.36, 1)")
                        hover=hoverTile(site.host, site.url)
                        testId=`tile-wrap-${site.host}`
                        view position="relative"
                          width="100%"
                          height="100%"
                          opacity=(tileConcealed ? 0 : 1)
                          scale=(tileConcealed ? 0.94 : 1)
                          translate=(tileConcealed ? "0px 8px" : "0px 0px")
                          filter=(tileConcealed ? "blur(6px)" : "blur(0px)")
                          transition=(tileConcealed or vp.prefersReducedMotion ? "none" : `opacity 340ms ease-out ${tileWaveDelayMs(idx, gridCols, st.hasResume)}ms, scale 340ms cubic-bezier(0.22, 1, 0.36, 1) ${tileWaveDelayMs(idx, gridCols, st.hasResume)}ms, translate 340ms cubic-bezier(0.22, 1, 0.36, 1) ${tileWaveDelayMs(idx, gridCols, st.hasResume)}ms, filter 340ms ease-out ${tileWaveDelayMs(idx, gridCols, st.hasResume)}ms`)
                          button appearance="none"
                            class=TileButton
                            pointerdown=prewarmTile(site.url)
                            press=openSite(site.url, idx)
                            scale=(hoveredHost == site.host ? 1.03 : 1)
                            title=site.host
                            aria-label=site.name
                            testId=`tile-${site.host}`
                            if site.icon != ""
                              image site.icon width=40 height=40 border-radius=9 object-fit="contain"
                            else
                              view width=40
                                height=40
                                border-radius=9
                                background-color="-exact-secondary-fill"
                                display="flex"
                                align-items="center"
                                justify-content="center"
                                text site.initial font-size=20 font-weight=600 color="-exact-label"
                            text site.name font-weight=500
                              font-size=13
                              color="-exact-label"
                              max-width="90%"
                              line-clamp=1
                              testId=`tile-name-${site.host}`
                          button appearance="none"
                            class=RemoveBtn
                            press=removeSite(site.host)
                            opacity=(hoveredHost == site.host ? 1 : 0)
                            aria-label=`Remove ${site.name}`
                            title="Remove"
                            testId=`remove-${site.host}`
                            text "×"

                    // Trailing "+" card in the mosaic: opens the streaming provider picker
                    view position="absolute"
                      top=0
                      left=0
                      width=128
                      height=80
                      translate=`${tileX(st.sites.length, gridCols)}px ${tileY(st.sites.length, gridCols)}px`
                      transition=(vp.prefersReducedMotion or not homeItemsShown ? "none" : "translate 220ms cubic-bezier(0.22, 1, 0.36, 1)")
                      hover=hoverAddTile
                      testId="add-provider-wrap"
                      view position="relative"
                        width="100%"
                        height="100%"
                        opacity=(tileConcealed ? 0 : 1)
                        scale=(tileConcealed ? 0.94 : 1)
                        translate=(tileConcealed ? "0px 8px" : "0px 0px")
                        filter=(tileConcealed ? "blur(6px)" : "blur(0px)")
                        transition=(tileConcealed or vp.prefersReducedMotion ? "none" : `opacity 340ms ease-out ${tileWaveDelayMs(st.sites.length, gridCols, st.hasResume)}ms, scale 340ms cubic-bezier(0.22, 1, 0.36, 1) ${tileWaveDelayMs(st.sites.length, gridCols, st.hasResume)}ms, translate 340ms cubic-bezier(0.22, 1, 0.36, 1) ${tileWaveDelayMs(st.sites.length, gridCols, st.hasResume)}ms, filter 340ms ease-out ${tileWaveDelayMs(st.sites.length, gridCols, st.hasResume)}ms`)
                        button appearance="none"
                          class=AddTileButton
                          press=openProviders
                          scale=(addTileHovered ? 1.03 : 1)
                          aria-label="Add streaming service"
                          title="Add streaming service"
                          testId="add-provider-card"
                          view width=34
                            height=34
                            border-radius=17
                            background-color="-exact-secondary-fill"
                            display="flex"
                            align-items="center"
                            justify-content="center"
                            text "+" font-size=22 font-weight=400 color=(addTileHovered ? "-exact-label" : "-exact-secondary-label")
                          text "Add Service" font-weight=500
                            font-size=12
                            color=(addTileHovered ? "-exact-label" : "-exact-secondary-label")

                  if isEmpty
                    column testId="empty-state"
                      width="100%"
                      align-items="center"
                      justify-content="center"
                      gap=4
                      padding-top=28
                      padding-bottom=12
                      padding-left=16
                      padding-right=16
                      box-sizing="border-box"
                      text "Click + to add streaming services, or watch any video site." color="-exact-secondary-label"
                        font-size=13
                        text-align="center"
                      row align-items="center" justify-content="center" gap=4
                        text "Press" color="-exact-secondary-label" font-size=13
                        view class=KeyBadge
                          text "⌘L" color="-exact-label" font-size=13 testId="empty-shortcut"
                        text "to open a URL." color="-exact-secondary-label" font-size=13

            // Top-edge 18px drag strip: hover reveals, drag moves window, double-click locks video aspect
            view id="drag-strip"
              testId="drag-strip"
              app-region="drag"
              dblclick=toggleAspectLock
              hover=hoverDragStrip
              position="absolute"
              top=0
              left=0
              right=0
              height=18
              z-index=20
              background-color="light-dark(rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.45))"
              opacity=(dragStripHovered ? 1 : 0)
              transition=(vp.prefersReducedMotion ? "none" : "opacity 160ms ease")

            // Floating URL / search bar overlay (⌘L)
            if urlOpen
              view testId="url-bar" position="absolute" top=24 left=10 right=10 z-index=30
                input id="url-input"
                  testId="url-input"
                  hatch="url-input"
                  data-select-seq=`${selectSeq}`
                  value=urlDraft
                  input=editUrl
                  submit=submitUrl
                  key=urlKeyDown
                  placeholder="URL or search — Enter to go, Esc to cancel"
                  aria-label="Location"
                  autofocus=true
                  width="100%"
                  font-size=13
                  box-sizing="border-box"

            // GPU WGSL opening morph shader: seamlessly hands off into true native Liquid Glass
            if showOpeningMorph
              canvas surface=shader(src="assets/opening-morph.wgsl", alphaMode="premultiplied", isHome=(isHome ? 1 : 0))
                position="absolute"
                inset=0
                width="100%"
                height="100%"
                z-index=50
                pointer-events="none"
                aria-hidden=true
                testId="opening-morph"

            // GPU WGSL home reveal & site wipe transition shader (dual-slot mount resets u.time to 0 on new gesture)
            if showHomeFx and fxSlot == 0
              canvas surface=shader(src="assets/home-transition.wgsl", alphaMode="premultiplied", effectKind=fxKind, siteCount=gridTotalTiles, gridCols=gridCols, hasResume=(st.hasResume ? 1 : 0), resumeH=resumeEstH, originCx=fxOriginCx, originCy=fxOriginCy, originW=fxOriginW, originH=fxOriginH, originRadius=fxOriginR, releaseAt=fxReleaseAt, revealStyle=revealStyleCode)
                position="absolute"
                inset=0
                width="100%"
                height="100%"
                z-index=51
                pointer-events="none"
                aria-hidden=true
                testId="home-transition-fx"

            if showHomeFx and fxSlot == 1
              canvas surface=shader(src="assets/home-transition.wgsl", alphaMode="premultiplied", effectKind=fxKind, siteCount=gridTotalTiles, gridCols=gridCols, hasResume=(st.hasResume ? 1 : 0), resumeH=resumeEstH, originCx=fxOriginCx, originCy=fxOriginCy, originW=fxOriginW, originH=fxOriginH, originRadius=fxOriginR, releaseAt=fxReleaseAt, revealStyle=revealStyleCode)
                position="absolute"
                inset=0
                width="100%"
                height="100%"
                z-index=51
                pointer-events="none"
                aria-hidden=true
                testId="home-transition-fx"

        // Streaming providers directory page (opened from the trailing "+" card in the Home mosaic)
        if e.name == "providers"
          column navigationKey=`${e.id}`
            navigationBar="none"
            testId="providers-view"
            position="absolute"
            inset=0
            width="100%"
            height="100%"
            z-index=35
            background-color=(st.nativeBackdrop ? "transparent" : "-exact-background")
            background-image=(st.nativeBackdrop ? "none" : "linear-gradient(180deg, #1c1d22 0%, #0b0b0d 70%)")
            box-sizing="border-box"

            head title="Add Streaming Service"

            // Top-edge 18px drag strip so the chromeless window remains draggable on the Providers page
            view app-region="drag"
              hover=hoverDragStrip
              position="absolute"
              top=0
              left=0
              right=0
              height=18
              z-index=20
              background-color="light-dark(rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.45))"
              opacity=(dragStripHovered ? 1 : 0)
              transition=(vp.prefersReducedMotion ? "none" : "opacity 160ms ease")

            column flex-shrink=0 width="100%" padding-top=24 padding-left=16 padding-right=16 padding-bottom=10 gap=8 box-sizing="border-box"
              row width="100%" align-items="center" justify-content="space-between" gap=8
                row flex=1 min-width=0 align-items="center" gap=8
                  button appearance="none"
                    class=HeaderBtn
                    press=closeProviders
                    aria-label="Back to Home"
                    testId="providers-back"
                    text "←"
                  text "Streaming Services" role="heading" aria-level=1 font-size=15 font-weight=600 color="-exact-label" line-clamp=1
                button appearance="none"
                  class=(st.sites.length > 0 ? HeaderDoneBtn : HeaderBtn)
                  press=closeProviders
                  aria-label="Done"
                  testId="providers-done"
                  text (st.sites.length > 0 ? `Done (${st.sites.length})` : "Done")

              input type="search"
                id="providers-search"
                testId="providers-search"
                value=providerQuery
                input=editProviderQuery
                key=providerKeyDown
                placeholder="Search streaming providers (Netflix, Apple TV+, Twitch…)"
                aria-label="Search streaming providers"
                width="100%"
                box-sizing="border-box"

              row role="tablist" aria-label="Provider categories" width="100%" gap=6 flex-wrap="wrap"
                button appearance="none"
                  role="tab"
                  aria-selected=(providerCategory == "all")
                  class=(providerCategory == "all" ? FilterPillActive : FilterPill)
                  press=setProviderCategory("all")
                  testId="provider-cat-all"
                  text "All"
                button appearance="none"
                  role="tab"
                  aria-selected=(providerCategory == "streaming")
                  class=(providerCategory == "streaming" ? FilterPillActive : FilterPill)
                  press=setProviderCategory("streaming")
                  testId="provider-cat-streaming"
                  text "Streaming"
                button appearance="none"
                  role="tab"
                  aria-selected=(providerCategory == "video")
                  class=(providerCategory == "video" ? FilterPillActive : FilterPill)
                  press=setProviderCategory("video")
                  testId="provider-cat-video"
                  text "Video & Live"
                button appearance="none"
                  role="tab"
                  aria-selected=(providerCategory == "live")
                  class=(providerCategory == "live" ? FilterPillActive : FilterPill)
                  press=setProviderCategory("live")
                  testId="provider-cat-live"
                  text "Live & Sports"
                button appearance="none"
                  role="tab"
                  aria-selected=(providerCategory == "anime")
                  class=(providerCategory == "anime" ? FilterPillActive : FilterPill)
                  press=setProviderCategory("anime")
                  testId="provider-cat-anime"
                  text "Anime & Indie"
                button appearance="none"
                  role="tab"
                  aria-selected=(providerCategory == "free")
                  class=(providerCategory == "free" ? FilterPillActive : FilterPill)
                  press=setProviderCategory("free")
                  testId="provider-cat-free"
                  text "Free"

            scroll flex=1 min-height=0 width="100%" scrollbar-width="none"
              column width="100%" padding-top=4 padding-left=16 padding-right=16 padding-bottom=16 gap=12 box-sizing="border-box"
                if providers.items.length == 0
                  column testId="providers-empty" width="100%" align-items="center" justify-content="center" gap=8 padding-top=28 padding-bottom=20
                    text "No matching streaming providers." font-size=13 color="-exact-secondary-label" text-align="center"
                    button appearance="none"
                      class=HeaderDoneBtn
                      press=openUrlBarFromProviders
                      testId="providers-open-url"
                      text (providerQuery.trim() != "" ? `Open "${providerQuery.trim()}" in URL Bar` : "Open URL Bar (⌘L)")
                else
                  row testId="providers-grid" width="100%" flex-wrap="wrap" gap=10
                    for p in providers.items key=p.id
                      button appearance="none"
                        class=(addedHosts.includes(p.normHost) ? ProviderCardAdded : ProviderCard)
                        press=toggleProvider(p.name, p.url, p.host, p.icon)
                        hover=hoverProvider(p.id)
                        scale=(hoveredProviderId == p.id ? 1.03 : 1)
                        background-color=(addedHosts.includes(p.normHost) ? (hoveredProviderId == p.id ? "rgba(20, 160, 160, 0.24)" : "rgba(20, 160, 160, 0.16)") : (hoveredProviderId == p.id ? "-exact-fill" : "-exact-tertiary-fill"))
                        title=`${p.name} (${p.host})`
                        aria-label=(addedHosts.includes(p.normHost) ? `Remove ${p.name}` : `Add ${p.name}`)
                        aria-pressed=addedHosts.includes(p.normHost)
                        testId=`provider-${p.id}`
                        image p.icon width=40 height=40 border-radius=9 object-fit="contain"
                        text p.name font-size=12
                          font-weight=500
                          color="-exact-label"
                          max-width="92%"
                          line-clamp=1
                          text-align="center"
                        if addedHosts.includes(p.normHost)
                          view position="absolute"
                            top=5
                            right=5
                            width=18
                            height=18
                            border-radius=9
                            background-color="AccentColor"
                            display="flex"
                            align-items="center"
                            justify-content="center"
                            testId=`provider-added-${p.id}`
                            text "✓" font-size=11 font-weight=700 color="AccentColorText"

                  text "Click any logo to add a card to Home, then open the card to sign in." font-size=11 color="-exact-secondary-label" text-align="center" width="100%" padding-top=4

        // Dedicated Settings window (macOS: named `settings` window via ⌘,; web/Linux: in-place route)
        if e.name == "settings"
          column navigationKey=`${e.id}`
            navigationBar="none"
            testId="settings-view"
            position="absolute"
            inset=0
            width="100%"
            height="100%"
            z-index=40
            background-color="-exact-background"
            box-sizing="border-box"

            head title="Settings"

            if isMainWindow
              header display="flex" align-items="center" justify-content="space-between" width="100%" padding-top=16 padding-left=20 padding-right=20 padding-bottom=10 box-sizing="border-box"
                text "Settings" role="heading" aria-level=1 font-size=16 font-weight=600
                button press=closeSubRoute aria-label="Done" testId="settings-done"
                  text "Done"

            scroll flex=1 min-height=0 width="100%"
              column width="100%" gap=14 padding-top=(isMainWindow ? 6 : 16) padding-left=20 padding-right=20 padding-bottom=20 box-sizing="border-box"
                // Section 1: Quick Fade (Global)
                column width="100%" gap=8
                  column gap=2
                    text "Quick Fade (Global)" font-size=13 font-weight=600
                    text "Temporarily fade Float from any app to see what is behind it." font-size=11 color="-exact-secondary-label"

                  row role="radiogroup" aria-label="Quick Fade Trigger" class=SegmentedWrap
                    button appearance="none"
                      role="radio"
                      aria-checked=(st.peekTrigger == "rightCommand")
                      class=(st.peekTrigger == "rightCommand" ? SegmentedBtnActive : SegmentedBtn)
                      press=setPeekTrigger("rightCommand")
                      testId="trigger-right-cmd"
                      text "Hold Right ⌘"
                    button appearance="none"
                      role="radio"
                      aria-checked=(st.peekTrigger == "rightOption")
                      class=(st.peekTrigger == "rightOption" ? SegmentedBtnActive : SegmentedBtn)
                      press=setPeekTrigger("rightOption")
                      testId="trigger-right-opt"
                      text "Hold Right ⌥"
                    button appearance="none"
                      role="radio"
                      aria-checked=(st.peekTrigger == "hotkey")
                      class=(st.peekTrigger == "hotkey" ? SegmentedBtnActive : SegmentedBtn)
                      press=setPeekTrigger("hotkey")
                      testId="trigger-hotkey"
                      text "Custom Hotkey"
                    button appearance="none"
                      role="radio"
                      aria-checked=(st.peekTrigger == "none")
                      class=(st.peekTrigger == "none" ? SegmentedBtnActive : SegmentedBtn)
                      press=setPeekTrigger("none")
                      testId="trigger-none"
                      text "Off"

                  if st.peekTrigger == "hotkey"
                    row width="100%" align-items="center" justify-content="space-between" gap=8
                      row align-items="center" gap=8
                        view class=KeyBadge
                          text (st.peekHotkeyLabel != "" ? st.peekHotkeyLabel : "None") font-size=12 font-weight=500 testId="peek-hotkey-badge"
                        button press=startRecording("peek") testId="record-peek-hotkey"
                          text (recordingTarget == "peek" ? "Listening…" : "Record…")
                      row role="radiogroup" aria-label="Custom Hotkey Mode" width=136 class=SegmentedWrap
                        button appearance="none"
                          role="radio"
                          aria-checked=st.peekHold
                          class=(st.peekHold ? SegmentedBtnActive : SegmentedBtn)
                          press=setPeekHold("true")
                          testId="peek-mode-hold"
                          text "Hold"
                        button appearance="none"
                          role="radio"
                          aria-checked=(not st.peekHold)
                          class=(not st.peekHold ? SegmentedBtnActive : SegmentedBtn)
                          press=setPeekHold("false")
                          testId="peek-mode-toggle"
                          text "Toggle"

                  if needsAccessibility
                    row width="100%"
                      align-items="center"
                      justify-content="space-between"
                      gap=10
                      padding=10
                      border-radius=9
                      background-color="-exact-tertiary-fill"
                      border-width=1
                      border-style="solid"
                      border-color="-exact-system-orange"
                      box-sizing="border-box"
                      column flex=1 min-width=0 gap=2
                        text `Enable Accessibility for ${st.peekTrigger == "rightCommand" ? "Right ⌘" : "Right ⌥"}` font-size=11 font-weight=600 color="-exact-system-orange"
                        text "Required by macOS to detect bare modifier keys when other apps are focused. Custom Hotkey works without permission." font-size=11 color="-exact-secondary-label"
                      button press=requestPeekPermission testId="grant-accessibility"
                        text "Grant…"

                  if st.peekTrigger != "none"
                    column width="100%" gap=8
                      row width="100%" align-items="center" justify-content="space-between"
                        text "Fade Opacity" font-size=12 font-weight=500
                        text peekPercent font-size=12 font-weight=600 color="-exact-system-teal" testId="settings-peek-pct"
                      row role="radiogroup" aria-label="Fade Opacity Presets" class=SegmentedWrap
                        button appearance="none"
                          role="radio"
                          aria-checked=(round(st.peekAlpha * 100) == 15)
                          class=(round(st.peekAlpha * 100) == 15 ? SegmentedBtnActive : SegmentedBtn)
                          press=setPeekAlpha("0.15")
                          testId="peek-preset-15"
                          text "15%"
                        button appearance="none"
                          role="radio"
                          aria-checked=(round(st.peekAlpha * 100) == 25)
                          class=(round(st.peekAlpha * 100) == 25 ? SegmentedBtnActive : SegmentedBtn)
                          press=setPeekAlpha("0.25")
                          testId="peek-preset-25"
                          text "25%"
                        button appearance="none"
                          role="radio"
                          aria-checked=(round(st.peekAlpha * 100) == 50)
                          class=(round(st.peekAlpha * 100) == 50 ? SegmentedBtnActive : SegmentedBtn)
                          press=setPeekAlpha("0.5")
                          testId="peek-preset-50"
                          text "50%"
                        button appearance="none"
                          role="radio"
                          aria-checked=(round(st.peekAlpha * 100) == 75)
                          class=(round(st.peekAlpha * 100) == 75 ? SegmentedBtnActive : SegmentedBtn)
                          press=setPeekAlpha("0.75")
                          testId="peek-preset-75"
                          text "75%"
                      input type="range"
                        min=0.15
                        max=0.95
                        step="any"
                        value=st.peekAlpha
                        input=onPeekAlphaRange
                        aria-label="Fade Opacity"
                        testId="settings-peek-slider"

                hr width="100%"

                // Section 2: Video Picture (HDR, Stream Brightness & Contrast)
                column width="100%" gap=10
                  row width="100%" align-items="center" justify-content="space-between" gap=8
                    column flex=1 min-width=0 gap=2
                      row align-items="center" gap=6
                        text "Video Picture" font-size=13 font-weight=600
                        if activeStreamLabel != ""
                          view class=KeyBadge
                            text activeStreamLabel font-size=10 font-weight=600 color="-exact-system-teal" testId="settings-stream-badge"
                      text "Adjust brightness, contrast, and HDR playback." font-size=11 color="-exact-secondary-label"
                    button press=resetVideoFilters disabled=isPictureDefault testId="settings-reset-picture"
                      text "Reset"

                  column width="100%" gap=6
                    column gap=2
                      text "HDR Playback" font-size=12 font-weight=500
                      text "Prefer SDR asks streaming sites for SDR instead of HDR / Dolby Vision (reloads page)." font-size=11 color="-exact-secondary-label"
                    row role="radiogroup" aria-label="HDR Playback" class=SegmentedWrap
                      button appearance="none"
                        role="radio"
                        aria-checked=(not st.preferSdr)
                        class=(not st.preferSdr ? SegmentedBtnActive : SegmentedBtn)
                        press=setPreferSdr("false")
                        testId="hdr-mode-allow"
                        text "Allow HDR"
                      button appearance="none"
                        role="radio"
                        aria-checked=st.preferSdr
                        class=(st.preferSdr ? SegmentedBtnActive : SegmentedBtn)
                        press=setPreferSdr("true")
                        testId="hdr-mode-sdr"
                        text "Prefer SDR"

                  column width="100%" gap=6
                    column gap=2
                      text "Brightness by Stream Kind" font-size=12 font-weight=500
                      text "Apply separate brightness levels automatically for HDR and SDR video streams." font-size=11 color="-exact-secondary-label"
                    row role="radiogroup" aria-label="Brightness by Stream Kind" class=SegmentedWrap
                      button appearance="none"
                        role="radio"
                        aria-checked=(not st.streamBrightness)
                        class=(not st.streamBrightness ? SegmentedBtnActive : SegmentedBtn)
                        press=setStreamBrightness("false")
                        testId="brightness-mode-single"
                        text "Single"
                      button appearance="none"
                        role="radio"
                        aria-checked=st.streamBrightness
                        class=(st.streamBrightness ? SegmentedBtnActive : SegmentedBtn)
                        press=setStreamBrightness("true")
                        testId="brightness-mode-stream"
                        text "Separate HDR / SDR"

                  column width="100%" gap=4
                    row width="100%" align-items="center" justify-content="space-between"
                      text (st.streamBrightness ? (st.activeVideoStream == "sdr" ? "SDR Brightness (Active)" : "SDR Brightness") : "Brightness") font-size=12 font-weight=500
                      text brightnessPercent font-size=12 font-weight=600 color="-exact-system-teal" testId="settings-brightness-pct"
                    input type="range"
                      min=0.5
                      max=2
                      step="any"
                      value=st.videoBrightness
                      input=onBrightnessRange
                      aria-label=(st.streamBrightness ? "SDR Brightness" : "Brightness")
                      testId="settings-brightness-slider"

                  if st.streamBrightness
                    column width="100%" gap=4
                      row width="100%" align-items="center" justify-content="space-between"
                        text (st.activeVideoStream == "hdr" ? "HDR Brightness (Active)" : "HDR Brightness") font-size=12 font-weight=500
                        text hdrBrightnessPercent font-size=12 font-weight=600 color="-exact-system-teal" testId="settings-hdr-brightness-pct"
                      input type="range"
                        min=0.5
                        max=2
                        step="any"
                        value=st.hdrVideoBrightness
                        input=onHdrBrightnessRange
                        aria-label="HDR Brightness"
                        testId="settings-hdr-brightness-slider"

                  column width="100%" gap=4
                    row width="100%" align-items="center" justify-content="space-between"
                      text "Contrast" font-size=12 font-weight=500
                      text contrastPercent font-size=12 font-weight=600 color="-exact-system-teal" testId="settings-contrast-pct"
                    input type="range"
                      min=0.5
                      max=2
                      step="any"
                      value=st.videoContrast
                      input=onContrastRange
                      aria-label="Contrast"
                      testId="settings-contrast-slider"

                hr width="100%"

                // Section 3: Motion & Glass Transitions
                column width="100%" gap=10
                  column gap=2
                    text "Motion & Transitions" font-size=13 font-weight=600
                    text "GPU shader & surface distortion effects for revealing saved sites and opening videos." font-size=11 color="-exact-secondary-label"

                  column width="100%" gap=6
                    text "Saved Item Reveal" font-size=12 font-weight=500
                    column width="100%" gap=6 role="radiogroup" aria-label="Saved Item Reveal Style"
                      row class=SegmentedWrap
                        button appearance="none"
                          role="radio"
                          aria-checked=(st.revealStyle == "wave")
                          class=(st.revealStyle == "wave" ? SegmentedBtnActive : SegmentedBtn)
                          press=setRevealStyle("wave")
                          testId="reveal-style-wave"
                          text "Wave + Bevel"
                        button appearance="none"
                          role="radio"
                          aria-checked=(st.revealStyle == "curtain")
                          class=(st.revealStyle == "curtain" ? SegmentedBtnActive : SegmentedBtn)
                          press=setRevealStyle("curtain")
                          testId="reveal-style-curtain"
                          text "Glass Curtain"
                        button appearance="none"
                          role="radio"
                          aria-checked=(st.revealStyle == "ripple")
                          class=(st.revealStyle == "ripple" ? SegmentedBtnActive : SegmentedBtn)
                          press=setRevealStyle("ripple")
                          testId="reveal-style-ripple"
                          text "Liquid Ripple"
                      row class=SegmentedWrap
                        button appearance="none"
                          role="radio"
                          aria-checked=(st.revealStyle == "frost")
                          class=(st.revealStyle == "frost" ? SegmentedBtnActive : SegmentedBtn)
                          press=setRevealStyle("frost")
                          testId="reveal-style-frost"
                          text "Frost Thaw"
                        button appearance="none"
                          role="radio"
                          aria-checked=(st.revealStyle == "louvers")
                          class=(st.revealStyle == "louvers" ? SegmentedBtnActive : SegmentedBtn)
                          press=setRevealStyle("louvers")
                          testId="reveal-style-louvers"
                          text "3D Louvers"
                        button appearance="none"
                          role="radio"
                          aria-checked=(st.revealStyle == "anamorphic")
                          class=(st.revealStyle == "anamorphic" ? SegmentedBtnActive : SegmentedBtn)
                          press=setRevealStyle("anamorphic")
                          testId="reveal-style-anamorphic"
                          text "Anamorphic"

                  column width="100%" gap=6
                    text "Open Site Wipe" font-size=12 font-weight=500
                    row role="radiogroup" aria-label="Open Site Wipe Style" class=SegmentedWrap
                      button appearance="none"
                        role="radio"
                        aria-checked=(st.openStyle == "lens")
                        class=(st.openStyle == "lens" ? SegmentedBtnActive : SegmentedBtn)
                        press=setOpenStyle("lens")
                        testId="open-style-lens"
                        text "Tile Lens"
                      button appearance="none"
                        role="radio"
                        aria-checked=(st.openStyle == "diagonal")
                        class=(st.openStyle == "diagonal" ? SegmentedBtnActive : SegmentedBtn)
                        press=setOpenStyle("diagonal")
                        testId="open-style-diagonal"
                        text "Diagonal Wipe"
                      button appearance="none"
                        role="radio"
                        aria-checked=(st.openStyle == "portal")
                        class=(st.openStyle == "portal" ? SegmentedBtnActive : SegmentedBtn)
                        press=setOpenStyle("portal")
                        testId="open-style-portal"
                        text "Portal Warp"
                      button appearance="none"
                        role="radio"
                        aria-checked=(st.openStyle == "ripple")
                        class=(st.openStyle == "ripple" ? SegmentedBtnActive : SegmentedBtn)
                        press=setOpenStyle("ripple")
                        testId="open-style-ripple"
                        text "Liquid Ripple"

                hr width="100%"

                // Section 4: Show / Hide Window global shortcut
                row width="100%" align-items="center" justify-content="space-between" gap=8
                  column flex=1 min-width=0 gap=2
                    text "Show / Hide Window" font-size=13 font-weight=600
                    text "Global shortcut to toggle Float visibility." font-size=11 color="-exact-secondary-label"
                  row align-items="center" gap=8
                    view class=KeyBadge
                      text showHideHudKey font-size=12 font-weight=500 testId="show-hide-hotkey-badge"
                    button press=startRecording("show-hide") testId="record-show-hide-hotkey"
                      text (recordingTarget == "show-hide" ? "Listening…" : "Record…")

                if recordingTarget != ""
                  row id="hotkey-capture"
                    testId="hotkey-capture"
                    tabindex=0
                    key=captureHotKey
                    width="100%"
                    align-items="center"
                    justify-content="space-between"
                    gap=10
                    padding=10
                    border-radius=9
                    background-color="-exact-tertiary-fill"
                    border-width=1
                    border-style="solid"
                    border-color="AccentColor"
                    box-sizing="border-box"
                    column flex=1 min-width=0 gap=2
                      text `Press new ${recordingTarget == "show-hide" ? "Show / Hide" : "Quick Fade"} shortcut` font-size=12 font-weight=600
                      text (recordingNote != "" ? recordingNote : "Use ⌘, ⌃, or ⌥. ⌫ clears, Esc cancels.") font-size=11 color="-exact-secondary-label"
                    button press=cancelRecording testId="cancel-hotkey-record"
                      text "Cancel"

        // Floating HUD Keyboard Shortcuts Panel (macOS: windowKind="panel" nonactivating HUD; web/Linux: in-place route)
        if e.name == "shortcuts"
          column navigationKey=`${e.id}`
            navigationBar="none"
            testId="shortcuts-view"
            position="absolute"
            inset=0
            width="100%"
            height="100%"
            z-index=45
            padding=16
            gap=12
            box-sizing="border-box"
            background-color=(isShortcutsPanel ? "transparent" : "-exact-background")

            header display="flex" align-items="center" justify-content="space-between" width="100%" gap=8
              row align-items="center" gap=8
                text "Keyboard Shortcuts" role="heading" aria-level=1 font-size=14 font-weight=600
                view role="status"
                  padding-top=2
                  padding-bottom=2
                  padding-left=8
                  padding-right=8
                  border-radius=9
                  background-color="-exact-secondary-fill"
                  border-width=1
                  border-style="solid"
                  border-color="-exact-separator"
                  text "⌘/ or Esc" font-size=10 font-weight=500 color="-exact-system-teal"
              button press=closeSubRoute aria-label="Close Shortcuts" testId="shortcuts-close"
                text (isMainWindow ? "Done" : "×")

            hr width="100%"

            row width="100%" gap=10 align-items="stretch"
              column class=ShortcutGroup
                text "NAVIGATION" font-size=10 font-weight=600 color="-exact-system-teal"
                row width="100%" align-items="center" justify-content="space-between" gap=8
                  text "Open URL or Search" font-size=12
                  view class=KeyBadge
                    text "⌘L" font-size=11
                row width="100%" align-items="center" justify-content="space-between" gap=8
                  text "Open Clipboard URL" font-size=12
                  view class=KeyBadge
                    text "⇧⌘V" font-size=11
                row width="100%" align-items="center" justify-content="space-between" gap=8
                  text "Home Mosaic" font-size=12
                  view class=KeyBadge
                    text "⇧⌘H" font-size=11
                row width="100%" align-items="center" justify-content="space-between" gap=8
                  text "Add Streaming Service" font-size=12
                  view class=KeyBadge
                    text "⇧⌘P" font-size=11
                row width="100%" align-items="center" justify-content="space-between" gap=8
                  text "Resume Last Video" font-size=12
                  view class=KeyBadge
                    text "⇧⌘R" font-size=11
                row width="100%" align-items="center" justify-content="space-between" gap=8
                  text "Back / Forward" font-size=12
                  view class=KeyBadge
                    text "⌘[  ⌘]" font-size=11
                row width="100%" align-items="center" justify-content="space-between" gap=8
                  text "Reload Page" font-size=12
                  view class=KeyBadge
                    text "⌘R" font-size=11

              column class=ShortcutGroup
                text "VIDEO & WINDOW" font-size=10 font-weight=600 color="-exact-system-teal"
                row width="100%" align-items="center" justify-content="space-between" gap=8
                  text "Play / Pause" font-size=12
                  view class=KeyBadge
                    text "⌃Space" font-size=11
                row width="100%" align-items="center" justify-content="space-between" gap=8
                  text "Toggle Video Fill" font-size=12
                  view class=KeyBadge
                    text "⇧⌘F" font-size=11
                row width="100%" align-items="center" justify-content="space-between" gap=8
                  text "Expand Window" font-size=12
                  view class=KeyBadge
                    text "⇧⌘E" font-size=11
                row width="100%" align-items="center" justify-content="space-between" gap=8
                  text "Lock Video Aspect" font-size=12
                  view class=KeyBadge
                    text "⇧⌘A" font-size=11
                row width="100%" align-items="center" justify-content="space-between" gap=8
                  text "Opacity − / +" font-size=12
                  view class=KeyBadge
                    text "⌘−  ⌘=" font-size=11
                row width="100%" align-items="center" justify-content="space-between" gap=8
                  text "Brightness − / +" font-size=12
                  view class=KeyBadge
                    text "⌃⌘−  ⌃⌘=" font-size=11
                row width="100%" align-items="center" justify-content="space-between" gap=8
                  text "Click-Through" font-size=12
                  view class=KeyBadge
                    text "⇧⌘K" font-size=11
                row width="100%" align-items="center" justify-content="space-between" gap=8
                  text "Always on Top" font-size=12
                  view class=KeyBadge
                    text "⌘T" font-size=11

              column class=ShortcutGroup
                text "POSITION & GLOBAL" font-size=10 font-weight=600 color="-exact-system-teal"
                row width="100%" align-items="center" justify-content="space-between" gap=8
                  text "Dock Top / Bottom" font-size=12
                  view class=KeyBadge
                    text "⌃⌘1–6" font-size=11
                row width="100%" align-items="center" justify-content="space-between" gap=8
                  text peekHudDesc font-size=12 testId="hud-peek-desc"
                  view class=KeyBadge
                    text peekHudKey font-size=11 testId="hud-peek-key"
                row width="100%" align-items="center" justify-content="space-between" gap=8
                  text "Show / Hide Float" font-size=12
                  view class=KeyBadge
                    text showHideHudKey font-size=11 testId="hud-show-hide-key"
                row width="100%" align-items="center" justify-content="space-between" gap=8
                  text "Settings" font-size=12
                  view class=KeyBadge
                    text "⌘," font-size=11
                row width="100%" align-items="center" justify-content="space-between" gap=8
                  text "Drag / Aspect Lock" font-size=12
                  view class=KeyBadge
                    text "Top Strip" font-size=11
                row width="100%" align-items="center" justify-content="space-between" gap=8
                  text "Keyboard Shortcuts" font-size=12
                  view class=KeyBadge
                    text "⌘/" font-size=11

      // Menu bar & keyboard shortcut declarations (invisible strip clear of window edges; active in main window)
      if isMainWindow
        row position="absolute" bottom=12 left=24 height=4 opacity=0 z-index=25
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=checkForUpdates
            -exact-menu="about"
            disabled=(not st.canCheckUpdates)
            aria-label="Check for Updates…"
            testId="cmd-updates"
          link href="/settings"
            width=4
            height=4
            overflow="hidden"
            aria-keyshortcuts="Meta+,"
            aria-label="Settings…"
            testId="cmd-settings"
          button appearance="none"
            href="/settings"
            target="settings"
            width=4
            height=4
            overflow="hidden"
            -exact-menu="app"
            aria-label=hotkeyMenuTitle
            testId="cmd-hotkey"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=showHome
            -exact-menu="view"
            aria-keyshortcuts="Meta+Shift+H"
            aria-label="Home"
            testId="cmd-home"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=openProviders
            -exact-menu="view"
            aria-keyshortcuts="Meta+Shift+P"
            aria-label="Add Streaming Service…"
            testId="cmd-providers"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=resumeLast
            -exact-menu="view"
            aria-keyshortcuts="Meta+Shift+R"
            aria-label="Resume Last"
            testId="cmd-resume"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=openUrlBar
            -exact-menu="view"
            aria-keyshortcuts="Meta+L"
            aria-label="Open Location…"
            testId="cmd-open-url"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=openClipboard
            -exact-menu="view"
            aria-keyshortcuts="Meta+Shift+V"
            aria-label="Open URL from Clipboard"
            testId="cmd-clipboard"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=reloadPage
            -exact-menu="view"
            aria-keyshortcuts="Meta+R"
            aria-label="Reload"
            testId="cmd-reload"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=goBack
            -exact-menu="view"
            aria-keyshortcuts="Meta+["
            aria-label="Back"
            testId="cmd-back"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=goForward
            -exact-menu="view"
            aria-keyshortcuts="Meta+]"
            aria-label="Forward"
            testId="cmd-forward"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=toggleFill
            -exact-menu="view"
            aria-keyshortcuts="Meta+Shift+F"
            aria-selected=st.fill
            aria-label="Toggle Video Fill"
            testId="cmd-fill"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=toggleExpand
            -exact-menu="view"
            aria-keyshortcuts="Meta+Shift+E"
            aria-selected=st.expanded
            aria-label="Expand Window"
            testId="cmd-expand"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=toggleAspectLock
            -exact-menu="view"
            aria-keyshortcuts="Meta+Shift+A"
            aria-selected=st.aspectLocked
            aria-label="Lock to Video Aspect"
            testId="cmd-aspect"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=toggleTop
            -exact-menu="view"
            aria-keyshortcuts="Meta+T"
            aria-selected=st.onTop
            aria-label="Toggle Always on Top"
            testId="cmd-top"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=toggleClickThrough
            -exact-menu="view"
            aria-keyshortcuts="Meta+Shift+K"
            aria-selected=st.clickThrough
            aria-label="Toggle Click-Through"
            testId="cmd-click-through"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=fadeOut
            -exact-menu="view"
            aria-keyshortcuts="Meta+-"
            aria-label="More Transparent"
            testId="cmd-fade-out"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=fadeIn
            -exact-menu="view"
            aria-keyshortcuts="Meta+="
            aria-label="Less Transparent"
            testId="cmd-fade-in"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=dimVideo
            -exact-menu="view"
            aria-keyshortcuts="Control+Meta+-"
            aria-label="Decrease Brightness"
            testId="cmd-brightness-down"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=brightenVideo
            -exact-menu="view"
            aria-keyshortcuts="Control+Meta+="
            aria-label="Increase Brightness"
            testId="cmd-brightness-up"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=resetVideoFilters
            -exact-menu="view"
            aria-keyshortcuts="Control+Meta+0"
            aria-label="Reset Brightness & Contrast"
            testId="cmd-filters-reset"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=playPause
            -exact-menu="view"
            aria-keyshortcuts="Control+Space"
            aria-label="Play / Pause"
            testId="cmd-play-pause"
          if isMac
            link href="/shortcuts"
              target="shortcuts"
              windowKind="panel"
              width=4
              height=4
              overflow="hidden"
              aria-keyshortcuts="Meta+/"
              aria-label="Keyboard Shortcuts"
              testId="cmd-shortcuts"
          else
            link href="/shortcuts"
              width=4
              height=4
              overflow="hidden"
              aria-keyshortcuts="Meta+/"
              aria-label="Keyboard Shortcuts"
              testId="cmd-shortcuts"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=dockPosition(0)
            -exact-menu="window"
            aria-keyshortcuts="Control+Meta+1"
            aria-label="Top Left"
            testId="cmd-dock-0"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=dockPosition(1)
            -exact-menu="window"
            aria-keyshortcuts="Control+Meta+2"
            aria-label="Top Center"
            testId="cmd-dock-1"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=dockPosition(2)
            -exact-menu="window"
            aria-keyshortcuts="Control+Meta+3"
            aria-label="Top Right"
            testId="cmd-dock-2"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=dockPosition(3)
            -exact-menu="window"
            aria-keyshortcuts="Control+Meta+4"
            aria-label="Bottom Left"
            testId="cmd-dock-3"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=dockPosition(4)
            -exact-menu="window"
            aria-keyshortcuts="Control+Meta+5"
            aria-label="Bottom Center"
            testId="cmd-dock-4"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=dockPosition(5)
            -exact-menu="window"
            aria-keyshortcuts="Control+Meta+6"
            aria-label="Bottom Right"
            testId="cmd-dock-5"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=setPeekAlpha("0.25")
            -exact-menu="none"
            aria-label="Peek 25%"
            testId="cmd-peek-25"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=stepPeekAlpha(0.05)
            -exact-menu="none"
            aria-label="Peek +5%"
            testId="cmd-peek-inc"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=setPeekTrigger("hotkey")
            -exact-menu="none"
            aria-label="Peek Hotkey"
            testId="cmd-peek-hotkey"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=setPeekHold("false")
            -exact-menu="none"
            aria-label="Peek Toggle"
            testId="cmd-peek-toggle"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=setVideoBrightness("1.25")
            -exact-menu="none"
            aria-label="Brightness 125%"
            testId="cmd-brightness-125"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=setVideoContrast("1.15")
            -exact-menu="none"
            aria-label="Contrast 115%"
            testId="cmd-contrast-115"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=setRevealStyle("curtain")
            -exact-menu="none"
            aria-label="Reveal Curtain"
            testId="cmd-reveal-curtain"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=setRevealStyle("wave")
            -exact-menu="none"
            aria-label="Reveal Wave"
            testId="cmd-reveal-wave"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=setOpenStyle("diagonal")
            -exact-menu="none"
            aria-label="Open Diagonal"
            testId="cmd-open-diagonal"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=setOpenStyle("lens")
            -exact-menu="none"
            aria-label="Open Lens"
            testId="cmd-open-lens"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=setPreferSdr("true")
            -exact-menu="none"
            aria-label="Prefer SDR On"
            testId="cmd-prefer-sdr-on"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=setPreferSdr("false")
            -exact-menu="none"
            aria-label="Prefer SDR Off"
            testId="cmd-prefer-sdr-off"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=setStreamBrightness("true")
            -exact-menu="none"
            aria-label="Stream Brightness On"
            testId="cmd-stream-brightness-on"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=setStreamBrightness("false")
            -exact-menu="none"
            aria-label="Stream Brightness Off"
            testId="cmd-stream-brightness-off"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=setHdrVideoBrightness("1.75")
            -exact-menu="none"
            aria-label="HDR Brightness 175%"
            testId="cmd-hdr-brightness-175"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=setActiveVideoStream("hdr")
            -exact-menu="none"
            aria-label="Active Stream HDR"
            testId="cmd-stream-hdr"
          button appearance="none"
            width=4
            height=4
            overflow="hidden"
            press=setActiveVideoStream("sdr")
            -exact-menu="none"
            aria-label="Active Stream SDR"
            testId="cmd-stream-sdr"
